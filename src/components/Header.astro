---
import { nav, site } from '../config/site';
import Logo from './Logo.astro';
import Icon from './Icon.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

{
  site.announcement && (
    <aside class="announce" aria-label="Announcement">
      <div class="container announce-inner">
        <span>{site.announcement}</span>
      </div>
    </aside>
  )
}

<header class="site-header" data-header>
  <div class="container header-inner">
    <a href="/" class="brand">
      <Logo size="nav" label="Busy Biese, home" />
    </a>

    <nav class="desktop-nav" aria-label="Main">
      <ul role="list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <a href="/order/" class="btn btn-small order-btn">Order</a>
      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="visually-hidden">Open menu</span>
        <Icon name="menu" class="icon-open" stroke={1.5} />
        <Icon name="close" class="icon-close" stroke={1.5} />
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden data-mobile-menu>
    <div class="container">
      <nav aria-label="Mobile">
        <ul role="list" class="mobile-links">
          <li><a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a></li>
          {
            nav.map((item) => (
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <a href="/order/" class="btn mobile-order">Order now</a>
      <div class="mobile-social">
        <a href={site.links.instagram} target="_blank" rel="noopener">
          <Icon name="instagram" size={18} stroke={1.5} /> Instagram
        </a>
        <a href={site.links.whatsapp} target="_blank" rel="noopener">
          <Icon name="chat" size={18} stroke={1.5} /> WhatsApp
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .announce {
    background: var(--pink-matte);
    color: var(--cocoa);
    font-size: var(--step-micro);
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .announce-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 34px;
    text-align: center;
    padding-block: 7px;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--ivory);
    border-bottom: 1px solid var(--border);
    transition: box-shadow 0.25s var(--ease);
  }
  .site-header.is-scrolled {
    box-shadow: 0 8px 24px -20px rgba(92, 58, 51, 0.5);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 70px;
  }

  .brand {
    text-decoration: none;
    color: var(--cocoa);
    display: inline-flex;
    border-radius: 4px;
  }
  .brand:hover {
    text-decoration: none;
    color: var(--cocoa);
  }

  .desktop-nav {
    display: none;
  }
  .desktop-nav ul {
    display: flex;
    gap: 6px;
  }
  .desktop-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding: 0 12px;
    font-size: var(--step-micro);
    font-weight: 400;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--cocoa);
  }
  .desktop-nav a::after {
    content: '';
    position: absolute;
    left: 12px;
    right: calc(12px + 0.4em);
    bottom: 8px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease);
  }
  .desktop-nav a:hover {
    text-decoration: none;
    color: var(--rose-text);
  }
  .desktop-nav a:hover::after,
  .desktop-nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .menu-toggle {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 0;
    background: transparent;
    cursor: pointer;
    color: var(--cocoa);
  }
  .menu-toggle :global(.icon-close) {
    display: none;
  }
  .menu-toggle[aria-expanded='true'] :global(.icon-open) {
    display: none;
  }
  .menu-toggle[aria-expanded='true'] :global(.icon-close) {
    display: block;
  }

  .mobile-menu {
    border-top: 1px solid var(--border);
    background: var(--ivory);
    padding: 8px 0 28px;
    min-height: calc(100dvh - 70px);
    max-height: calc(100dvh - 70px);
    overflow-y: auto;
  }
  .mobile-links li {
    border-bottom: 1px solid var(--border);
  }
  .mobile-links a {
    display: flex;
    align-items: center;
    min-height: 58px;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--cocoa);
  }
  .mobile-links a[aria-current='page'] {
    color: var(--rose-text);
  }
  .mobile-order {
    width: 100%;
    margin-top: 22px;
  }
  .mobile-social {
    display: flex;
    gap: 22px;
    margin-top: 22px;
  }
  .mobile-social a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--step-micro);
    letter-spacing: 0.25em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--cocoa);
  }

  @media (max-width: 480px) {
    .announce {
      letter-spacing: 0.1em;
      font-size: 0.625rem;
    }
    .order-btn {
      padding: 10px 14px;
    }
  }

  @media (min-width: 900px) {
    .desktop-nav {
      display: block;
    }
    .menu-toggle,
    .mobile-menu {
      display: none !important;
    }
  }
</style>
