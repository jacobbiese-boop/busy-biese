---
import { nav, site } from '../config/site';
import Logo from './Logo.astro';
import Icon from './Icon.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

{
  site.announcement && (
    <aside class="announce" aria-label="Announcement">
      <div class="container announce-inner">
        <Icon name="clock" size={16} />
        <span>{site.announcement}</span>
      </div>
    </aside>
  )
}

<header class="site-header" data-header>
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Busy Biese, home">
      <Logo size={34} />
    </a>

    <nav class="desktop-nav" aria-label="Main">
      <ul role="list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <a href="/order/" class="btn btn-small order-btn">
        Order <Icon name="arrow" class="arrow" />
      </a>
      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="visually-hidden">Open menu</span>
        <Icon name="menu" class="icon-open" />
        <Icon name="close" class="icon-close" />
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden data-mobile-menu>
    <div class="container">
      <nav aria-label="Mobile">
        <ul role="list" class="mobile-links">
          <li><a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a></li>
          {
            nav.map((item) => (
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <a href="/order/" class="btn mobile-order">Start an order <Icon name="arrow" class="arrow" /></a>
      <div class="mobile-social">
        <a href={site.links.instagram} target="_blank" rel="noopener">
          <Icon name="instagram" size={20} /> Instagram
        </a>
        <a href={site.links.whatsapp} target="_blank" rel="noopener">
          <Icon name="chat" size={20} /> WhatsApp
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .announce {
    background: var(--espresso);
    color: var(--on-dark);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  .announce-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 38px;
    text-align: center;
    padding-block: 6px;
  }
  .announce :global(svg) {
    color: var(--honey);
    flex: none;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(246, 239, 229, 0.9);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid transparent;
    transition:
      border-color 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }
  .site-header.is-scrolled {
    border-bottom-color: var(--line);
    box-shadow: 0 6px 24px -18px rgba(35, 26, 21, 0.45);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 74px;
  }

  .brand {
    text-decoration: none;
    color: var(--ink);
    display: inline-flex;
  }
  .brand :global(.logo-word) {
    font-size: 1.42rem;
  }

  .desktop-nav {
    display: none;
  }
  .desktop-nav ul {
    display: flex;
    gap: 6px;
  }
  .desktop-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding: 0 14px;
    border-radius: 999px;
    font-weight: 650;
    font-size: 0.95rem;
    text-decoration: none;
    color: var(--ink-2);
    transition:
      background-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }
  .desktop-nav a:hover {
    background: var(--oat);
    color: var(--ink);
  }
  .desktop-nav a[aria-current='page'] {
    color: var(--ink);
    background: var(--honey-wash);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .menu-toggle {
    display: inline-grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: transparent;
    cursor: pointer;
  }
  .menu-toggle :global(.icon-close) {
    display: none;
  }
  .menu-toggle[aria-expanded='true'] :global(.icon-open) {
    display: none;
  }
  .menu-toggle[aria-expanded='true'] :global(.icon-close) {
    display: block;
  }

  .mobile-menu {
    border-top: 1px solid var(--line);
    background: var(--cream);
    padding: 12px 0 28px;
    min-height: calc(100dvh - 74px);
    max-height: calc(100dvh - 74px);
    overflow-y: auto;
  }
  .mobile-links li {
    border-bottom: 1px solid var(--line);
  }
  .mobile-links a {
    display: flex;
    align-items: center;
    min-height: 58px;
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--ink);
  }
  .mobile-links a[aria-current='page'] {
    color: var(--honey-deep);
  }
  .mobile-order {
    width: 100%;
    margin-top: 22px;
  }
  .mobile-social {
    display: flex;
    gap: 22px;
    margin-top: 20px;
  }
  .mobile-social a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 650;
    text-decoration: none;
    color: var(--ink-2);
  }

  @media (max-width: 380px) {
    .brand :global(.logo-word) {
      font-size: 1.22rem;
    }
    .order-btn {
      padding: 0 14px;
    }
  }

  @media (min-width: 900px) {
    .desktop-nav {
      display: block;
    }
    .menu-toggle,
    .mobile-menu {
      display: none !important;
    }
  }
</style>
