---
/**
 * Top section for inner pages. `title` may include <em> for an italic accent.
 * tone "pink" puts the heading on a dusty pink panel; "ivory" leaves it on the page.
 */
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  crumbs?: { label: string; href?: string }[];
  tone?: 'ivory' | 'pink';
}

const { eyebrow, title, lead, crumbs, tone = 'ivory' } = Astro.props;
---

<section class:list={['page-hero', `tone-${tone}`]}>
  <div class="container">
    <div class="hero-inner">
      {
        crumbs && crumbs.length > 0 && (
          <nav class="crumbs" aria-label="Breadcrumb">
            <ol role="list">
              {crumbs.map((c, i) => (
                <li>
                  {c.href && i < crumbs.length - 1 ? (
                    <a href={c.href}>{c.label}</a>
                  ) : (
                    <span aria-current="page">{c.label}</span>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 set:html={title} />
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
  </div>
</section>

<style>
  .page-hero {
    padding: clamp(28px, 4vw, 48px) 0 clamp(28px, 4vw, 44px);
  }
  .tone-ivory .hero-inner {
    padding-top: clamp(8px, 2vw, 24px);
  }
  .tone-pink .hero-inner {
    background: var(--pink);
    border-radius: var(--radius);
    padding: clamp(32px, 5vw, 64px) clamp(20px, 4vw, 48px);
  }
  h1 {
    max-width: 20ch;
    margin-bottom: 14px;
  }
  h1 :global(em) {
    font-style: italic;
    font-weight: 500;
  }
  .lead {
    max-width: 52ch;
    margin-bottom: 22px;
  }
  .lead:last-child {
    margin-bottom: 0;
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 18px;
    padding: 0;
    list-style: none;
    font-size: var(--step-micro);
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--mauve);
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 8px;
    color: var(--dashed);
  }
  .crumbs a {
    color: var(--mauve);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--cocoa);
    text-decoration: underline;
  }
  .crumbs [aria-current] {
    color: var(--cocoa);
  }
</style>
