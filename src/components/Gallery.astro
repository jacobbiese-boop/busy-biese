---
/**
 * A caption-free photo gallery. "mosaic" gives the first photo a double-size
 * tile; "grid" lays every photo out evenly. Photos that do not exist yet are
 * skipped, so the gallery simply grows as pictures are added.
 *
 * Tapping a photo opens it large in a viewer (previous / next, swipe, arrow
 * keys, Escape to close). Without JavaScript the link opens the photo itself.
 */
import { gallery } from '../data/menu';
import { hasPhoto, photoSrcset, photoUrl } from '../lib/photos';
import Icon from './Icon.astro';
import BeeLoader from './BeeLoader.astro';

interface Props {
  /** How many photos to show (from the start of the gallery list). */
  limit?: number;
  /** Skip the first n photos (to continue a gallery on another page). */
  offset?: number;
  variant?: 'mosaic' | 'grid';
  class?: string;
}

const { limit, offset = 0, variant = 'grid', class: className } = Astro.props;
const items = gallery.filter((g) => hasPhoto(g.photo)).slice(offset, limit ? offset + limit : undefined);
const sizes =
  variant === 'mosaic'
    ? '(min-width: 1100px) 300px, (min-width: 700px) 33vw, 50vw'
    : '(min-width: 1100px) 290px, (min-width: 700px) 33vw, 50vw';
const bigSizes = '(min-width: 1100px) 600px, (min-width: 700px) 66vw, 100vw';
---

{
  items.length > 0 && (
    <div class:list={['gallery-wrap', className]} data-gallery>
      <ul class:list={['gallery', `gallery-${variant}`]} role="list">
        {items.map((g, i) => {
          const big = variant === 'mosaic' && i === 0;
          const full = photoUrl(g.photo, 1400);
          return (
            <li class:list={['gallery-item', big && 'is-big']}>
              <a class="gallery-link" href={full} data-full={full} data-alt={g.alt}>
                <img
                  src={photoUrl(g.photo, big ? 1400 : 800)}
                  srcset={photoSrcset(g.photo)}
                  sizes={big ? bigSizes : sizes}
                  alt={g.alt}
                  width="800"
                  height="1000"
                  loading={i < 2 ? 'eager' : 'lazy'}
                  decoding="async"
                />
                <span class="visually-hidden">, open larger</span>
              </a>
            </li>
          );
        })}
      </ul>

      <dialog class="lightbox" aria-label="Photo viewer" data-lightbox>
        <div class="lightbox-bar">
          <p class="lightbox-count" data-lightbox-count aria-live="polite" />
          <button class="lightbox-btn" type="button" data-lightbox-close autofocus>
            <Icon name="close" size={20} stroke={1.6} />
            <span class="visually-hidden">Close</span>
          </button>
        </div>
        <figure class="lightbox-stage" data-lightbox-stage>
          <BeeLoader size={72} class="lightbox-loader" />
          <img class="lightbox-img" alt="" data-lightbox-img />
        </figure>
        <button class="lightbox-btn lightbox-prev" type="button" data-lightbox-prev>
          <Icon name="chevron" size={22} stroke={1.6} />
          <span class="visually-hidden">Previous photo</span>
        </button>
        <button class="lightbox-btn lightbox-next" type="button" data-lightbox-next>
          <Icon name="chevron" size={22} stroke={1.6} />
          <span class="visually-hidden">Next photo</span>
        </button>
      </dialog>
    </div>
  )
}

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const links = Array.from(root.querySelectorAll<HTMLAnchorElement>('.gallery-link'));
    const dialog = root.querySelector<HTMLDialogElement>('[data-lightbox]');
    const img = root.querySelector<HTMLImageElement>('[data-lightbox-img]');
    const stage = root.querySelector<HTMLElement>('[data-lightbox-stage]');
    const count = root.querySelector<HTMLElement>('[data-lightbox-count]');
    if (!dialog || !img || !stage || !count || links.length === 0 || typeof dialog.showModal !== 'function') return;

    let index = 0;
    const preload = (i: number) => {
      const a = links[(i + links.length) % links.length];
      if (a?.dataset.full) new Image().src = a.dataset.full;
    };
    const show = (i: number) => {
      index = (i + links.length) % links.length;
      const a = links[index];
      stage.classList.add('is-loading');
      img.onload = () => stage.classList.remove('is-loading');
      img.src = a.dataset.full || a.href;
      img.alt = a.dataset.alt || '';
      count.textContent = `${index + 1} of ${links.length}`;
      preload(index + 1);
      preload(index - 1);
    };
    const open = (i: number) => {
      show(i);
      dialog.showModal();
      document.documentElement.classList.add('lightbox-open');
    };

    links.forEach((a, i) =>
      a.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        e.preventDefault();
        open(i);
      }),
    );
    root.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
    root.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(index - 1));
    root.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(index + 1));
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
    // Tap outside the photo to close (but not at the end of a swipe)
    let swiped = false;
    dialog.addEventListener('click', (e) => {
      if (swiped) {
        swiped = false;
        return;
      }
      if (e.target === dialog || e.target === stage) dialog.close();
    });
    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('lightbox-open');
      links[index]?.focus({ preventScroll: true });
    });
    // Swipe left or right on touch screens
    let startX = 0;
    let startY = 0;
    stage.addEventListener('pointerdown', (e) => {
      startX = e.clientX;
      startY = e.clientY;
    });
    stage.addEventListener('pointerup', (e) => {
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy) * 1.4) {
        swiped = true;
        window.setTimeout(() => (swiped = false), 400);
        show(index + (dx < 0 ? 1 : -1));
      }
    });
  });
</script>

<style>
  .gallery {
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 700px) {
    .gallery {
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }
  }
  @media (min-width: 1000px) {
    .gallery {
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
    }
  }
  .gallery-item {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-s);
    background: var(--pink);
  }
  .gallery-link {
    position: absolute;
    inset: 0;
    display: block;
    cursor: zoom-in;
    border-radius: inherit;
  }
  .gallery-link:focus-visible {
    outline-offset: -3px;
  }
  .gallery-item img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease);
  }
  .gallery-item:hover img {
    transform: scale(1.04);
  }
  .gallery-mosaic .is-big {
    grid-column: span 2;
    grid-row: span 2;
    aspect-ratio: auto;
  }

  /* Viewer */
  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: #2b1c18;
    color: var(--ivory);
    overflow: hidden;
  }
  .lightbox[open] {
    display: grid;
    grid-template-rows: auto 1fr;
    animation: lightbox-in 0.25s var(--ease);
  }
  .lightbox::backdrop {
    background: #2b1c18;
  }
  @keyframes lightbox-in {
    from {
      opacity: 0;
    }
  }
  .lightbox-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: max(12px, env(safe-area-inset-top)) 16px 8px;
  }
  .lightbox-count {
    margin: 0;
    font-size: var(--step-micro);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--pink);
  }
  .lightbox-stage {
    position: relative;
    display: grid;
    place-items: center;
    margin: 0;
    padding: 0 12px max(16px, env(safe-area-inset-bottom));
    min-height: 0;
    touch-action: pan-y;
  }
  .lightbox-img {
    max-width: min(100%, 1100px);
    max-height: calc(100dvh - 96px);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius-s);
    transition: opacity 0.25s var(--ease);
    user-select: none;
    -webkit-user-drag: none;
  }
  .lightbox-stage :global(.lightbox-loader) {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    color: var(--pink);
    opacity: 0;
    transition: opacity 0.2s var(--ease);
    pointer-events: none;
  }
  .lightbox-stage.is-loading .lightbox-img {
    opacity: 0;
  }
  .lightbox-stage.is-loading :global(.lightbox-loader) {
    opacity: 1;
  }
  .lightbox-stage :global(.lightbox-loader) {
    --loader-bee-color: var(--ivory);
  }
  .lightbox-btn {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 999px;
    border: 1px solid rgba(251, 247, 242, 0.35);
    background: rgba(251, 247, 242, 0.08);
    color: var(--ivory);
    cursor: pointer;
    transition: background-color 0.2s var(--ease);
  }
  .lightbox-btn:hover {
    background: rgba(251, 247, 242, 0.2);
  }
  .lightbox-btn:focus-visible {
    outline: 2px solid var(--pink);
    outline-offset: 2px;
  }
  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    top: 50%;
    margin-top: -24px;
  }
  .lightbox-prev {
    left: 14px;
  }
  .lightbox-prev :global(svg) {
    transform: rotate(90deg);
  }
  .lightbox-next {
    right: 14px;
  }
  .lightbox-next :global(svg) {
    transform: rotate(-90deg);
  }
  @media (max-width: 699px) {
    .lightbox-prev,
    .lightbox-next {
      top: auto;
      bottom: max(18px, env(safe-area-inset-bottom));
      margin-top: 0;
    }
    .lightbox-stage {
      padding-bottom: 84px;
    }
    .lightbox-img {
      max-height: calc(100dvh - 180px);
    }
  }
  :global(html.lightbox-open) {
    overflow: hidden;
  }
</style>
