---
/**
 * Shows the first available photo from `names`. If none exist yet, shows a
 * dusty pink panel with a small rose bee, so layouts never break.
 */
import { photoSrcset, photoUrl, firstPhoto } from '../lib/photos';
import Bee from './Bee.astro';

interface Props {
  names?: string[];
  name?: string;
  alt: string;
  sizes?: string;
  ratio?: string;
  eager?: boolean;
  class?: string;
}

const {
  names,
  name,
  alt,
  sizes = '(min-width: 1100px) 380px, (min-width: 700px) 45vw, 100vw',
  ratio,
  eager = false,
  class: className,
} = Astro.props;

const list = names ?? (name ? [name] : []);
const chosen = firstPhoto(list);
---

<div class:list={['photo', className]} style={ratio ? `aspect-ratio: ${ratio}` : undefined}>
  {
    chosen ? (
      <img
        src={photoUrl(chosen, 800)}
        srcset={photoSrcset(chosen)}
        sizes={sizes}
        alt={alt}
        width="800"
        height="600"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={eager ? 'high' : 'auto'}
      />
    ) : (
      <div class="ph">
        <Bee size={56} color="var(--rose)" />
      </div>
    )
  }
</div>

<style>
  .photo {
    position: relative;
    overflow: hidden;
    background: var(--pink);
    width: 100%;
  }
  .photo img,
  .photo .ph {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .photo img {
    object-fit: cover;
  }
</style>
