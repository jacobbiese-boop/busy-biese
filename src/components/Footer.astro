---
import { site } from '../config/site';
import { categories } from '../data/menu';
import Logo from './Logo.astro';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
const { email, phone } = site.contact;
const webHost = 'busybiese.com';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="footer-logo"><Logo size="footer" label="Busy Biese, home" /></a>
        <p class="footer-blurb">
          A small-batch, made-to-order bakery in {site.location.city}, {site.location.region}. Baking since {
            site.established
          }.
        </p>
        <div class="footer-info">
          <span>{site.location.city}, {site.location.region} {site.location.postalCode}</span>
          {phone && <a href={`tel:${phone.replace(/[^0-9+]/g, '')}`}>{phone}</a>}
          {email && <a href={`mailto:${email}`}>{email}</a>}
          <a href="/">{webHost}</a>
          <a href={site.links.instagram} target="_blank" rel="noopener">{site.links.instagramHandle}</a>
        </div>
      </div>

      <nav aria-label="Footer: explore" class="footer-col">
        <h2 class="footer-head">Explore</h2>
        <ul role="list">
          <li><a href="/menu/">Menu</a></li>
          <li><a href="/catering/">Catering &amp; large orders</a></li>
          <li><a href="/order/">How to order</a></li>
          <li><a href="/about/">Our story</a></li>
          <li><a href="/policies/">Delivery &amp; policies</a></li>
        </ul>
      </nav>

      <nav aria-label="Footer: menu" class="footer-col">
        <h2 class="footer-head">The menu</h2>
        <ul role="list">
          {
            categories.map((c) => (
              <li>
                <a href={`/menu/#${c.id}`}>{c.name}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="footer-col">
        <h2 class="footer-head">Pickup &amp; delivery</h2>
        <ul role="list" class="facts">
          <li>Pickup in {site.location.city}</li>
          <li>Delivery within {site.delivery.radiusMiles} miles</li>
          <li>Order {site.ordering.noticeHours} hours ahead</li>
        </ul>
        <div class="social">
          <a href={site.links.instagram} target="_blank" rel="noopener" aria-label="Instagram">
            <Icon name="instagram" size={18} stroke={1.5} />
          </a>
          <a href={site.links.whatsapp} target="_blank" rel="noopener" aria-label="WhatsApp community">
            <Icon name="chat" size={18} stroke={1.5} />
          </a>
          {
            email && (
              <a href={`mailto:${email}`} aria-label="Email">
                <Icon name="mail" size={18} stroke={1.5} />
              </a>
            )
          }
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} Busy Biese. All rights reserved.</p>
      <p>
        <a href="/policies/#allergens">Allergen information</a>
        <span aria-hidden="true">·</span>
        <a href="/policies/">Order policy</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--cocoa);
    color: var(--pink);
    padding: clamp(44px, 6vw, 72px) 0 24px;
    font-size: var(--step-small);
    line-height: 1.8;
  }
  .site-footer a {
    color: var(--pink);
    text-decoration: none;
  }
  .site-footer a:hover {
    color: var(--ivory);
    text-decoration: underline;
  }

  .footer-top {
    display: grid;
    gap: 36px 28px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 190px), 1fr));
    padding-bottom: clamp(32px, 4vw, 48px);
  }
  @media (min-width: 900px) {
    .footer-top {
      grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
    }
  }

  .footer-logo {
    display: inline-flex;
    color: var(--pink);
    border-radius: 4px;
  }
  .footer-logo:hover {
    color: var(--pink);
    text-decoration: none;
  }
  .footer-blurb {
    margin: 18px 0 16px;
    max-width: 34ch;
    color: var(--pink);
  }
  .footer-info {
    display: flex;
    flex-direction: column;
    color: var(--pink-matte);
  }
  .footer-info a {
    color: var(--pink-matte);
    align-self: flex-start;
  }

  .footer-head {
    font-family: var(--font-body);
    font-size: var(--step-micro);
    font-weight: 400;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--ivory);
    margin: 6px 0 14px;
  }
  .footer-col li {
    margin-bottom: 4px;
  }

  .social {
    display: flex;
    gap: 10px;
    margin-top: 18px;
  }
  .social a {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid rgba(242, 212, 212, 0.4);
    transition:
      background-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }
  .social a:hover {
    background: var(--pink);
    color: var(--cocoa);
    border-color: var(--pink);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-top: 20px;
    border-top: 1px solid rgba(242, 212, 212, 0.25);
    font-size: var(--step-tiny);
    letter-spacing: 0.04em;
    color: var(--pink-matte);
  }
  .footer-bottom p {
    margin: 0;
    display: flex;
    gap: 10px;
  }
  .footer-bottom a {
    color: var(--pink-matte);
  }
</style>
