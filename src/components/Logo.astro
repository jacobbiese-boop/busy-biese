---
/**
 * The Busy Biese lockup: the bee at left, the name in Parisienne on one line.
 * No descriptor ever goes inside the lockup ("bakery" lives in the copy).
 *
 * Sizes follow Visual System 1.0: the bee is about 1.25x to 1.4x the script.
 *   nav     bee 30 / script 24   (site header)
 *   footer  bee 36 / script 26   (pink on cocoa)
 *   large   bee 66 / script 48   (about page, big moments)
 *   small   bee 24 / script 20   (the smallest allowed on screen)
 * Color is inherited from the surrounding text color.
 */
import Bee from './Bee.astro';

interface Props {
  size?: 'nav' | 'footer' | 'large' | 'small';
  /** Set when the lockup is the only thing naming the site, e.g. the header link. */
  label?: string;
  class?: string;
}

const { size = 'nav', label, class: className } = Astro.props;

const sizes = {
  small: { bee: 24, script: 20, gap: 6 },
  nav: { bee: 30, script: 24, gap: 8 },
  footer: { bee: 36, script: 26, gap: 8 },
  large: { bee: 66, script: 48, gap: 14 },
} as const;
const s = sizes[size];
---

<span class:list={['lockup', `lockup-${size}`, className]} style={`--lockup-gap:${s.gap}px; --lockup-script:${s.script}px`}>
  <Bee size={s.bee} label={label} />
  <span class="lockup-word" aria-hidden={label ? 'true' : undefined}>Busy Biese</span>
</span>

<style>
  .lockup {
    display: inline-flex;
    align-items: center;
    gap: var(--lockup-gap);
    color: inherit;
    white-space: nowrap;
  }
  .lockup-word {
    font-family: var(--font-script);
    font-weight: 400;
    font-size: var(--lockup-script);
    line-height: 1;
    letter-spacing: 0;
    /* Parisienne sits a touch high next to the bee; nudge it onto the same optical line. */
    transform: translateY(1px);
  }
</style>
