---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import Icon from '../../components/Icon.astro';
import ProductList from '../../components/ProductList.astro';
import { products, getCategory, relatedProducts, type Product } from '../../data/menu';
import { site } from '../../config/site';
import { availablePhotos, photoUrl, photoSrcset } from '../../lib/photos';
import { money, each, perItem, priceLabel, bestPerItem, sentenceList } from '../../lib/format';
import { formItem, orderLink } from '../../lib/order';
import { productJsonLd, breadcrumbJsonLd, faqJsonLd } from '../../lib/seo';

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const category = getCategory(product.category);
const photos = availablePhotos(product.photos);
const related = relatedProducts(product, 3);
const best = bestPerItem(product);
const showEach = product.tiers.some((t) => perItem(t) !== undefined);
const servingGuide = product.tiers.filter((t) => t.serves);
const order = orderLink({ type: 'Menu items', item: formItem(product) });
const description = `${product.short} ${priceLabel(product)}. Made to order in ${site.location.city}, IL.`;

const ld = [
  productJsonLd(product, Astro.site),
  breadcrumbJsonLd(
    [
      { name: 'Home', path: '/' },
      { name: 'Menu', path: '/menu/' },
      { name: product.name, path: `/menu/${product.slug}/` },
    ],
    Astro.site,
  ),
  ...(product.faq.length ? [faqJsonLd(product.faq)] : []),
];
---

<Base title={product.name} description={description} imageAlt={product.name} ogType="product" jsonLd={ld}>
  <section class="product">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol role="list">
          <li><a href="/menu/">Menu</a></li>
          <li><a href={`/menu/#${category.id}`}>{category.name}</a></li>
          <li><span aria-current="page">{product.name}</span></li>
        </ol>
      </nav>

      <div class="product-grid">
        <div class="gallery" data-gallery>
          <div class="gallery-main">
            <Photo names={product.photos} alt={product.name} ratio="1 / 1" eager sizes="(min-width: 900px) 560px, 100vw" />
            {
              product.badges && product.badges.length > 0 && (
                <div class="badges">
                  {product.badges.map((b) => (
                    <span class:list={['badge', b === 'Halal' ? 'badge-cocoa' : 'badge-pink']}>{b}</span>
                  ))}
                </div>
              )
            }
          </div>
          {
            photos.length > 1 && (
              <ul class="thumbs" role="list">
                {photos.map((p, i) => (
                  <li>
                    <button
                      type="button"
                      class:list={['thumb', i === 0 && 'is-active']}
                      data-src={photoUrl(p, 800)}
                      data-srcset={photoSrcset(p)}
                      aria-label={`Show photo ${i + 1} of ${photos.length}`}
                      aria-pressed={i === 0 ? 'true' : 'false'}
                    >
                      <img src={photoUrl(p, 800)} alt="" width="120" height="120" loading="lazy" decoding="async" />
                    </button>
                  </li>
                ))}
              </ul>
            )
          }
        </div>

        <div class="summary">
          <p class="eyebrow">{category.name}</p>
          <h1>{product.name}</h1>
          <p class="lead">{product.short}</p>

          <div class="price-block">
            <div>
              <p class="price">{priceLabel(product)}</p>
              {best && <p class="price-sub">As low as {each(best)} per {product.unit ?? 'item'}</p>}
            </div>
            {product.minimum && <p class="minimum">{product.minimum}</p>}
          </div>

          <table class="tiers">
            <caption class="visually-hidden">Prices for {product.name}</caption>
            <thead>
              <tr>
                <th scope="col">Size</th>
                <th scope="col">Price</th>
                {showEach && <th scope="col">Each</th>}
                <th scope="col"><span class="visually-hidden">Order</span></th>
              </tr>
            </thead>
            <tbody>
              {
                product.tiers.map((t) => {
                  const unit = perItem(t);
                  const tierOrder = orderLink({ type: 'Menu items', item: formItem(product, t) });
                  return (
                    <tr>
                      <th scope="row">{t.label}</th>
                      <td>{money(t.price)}</td>
                      {showEach && <td class="each">{unit ? each(unit) : ''}</td>}
                      <td class="tier-go">
                        <a
                          class="tier-order"
                          href={tierOrder.href}
                          target={tierOrder.external ? '_blank' : undefined}
                          rel={tierOrder.external ? 'noopener' : undefined}
                        >
                          Order<span class="visually-hidden"> {t.label}</span>
                        </a>
                      </td>
                    </tr>
                  );
                })
              }
            </tbody>
          </table>

          {
            product.flavors && (
              <div class="option-group">
                <p class="option-label">Flavors</p>
                <ul class="chips" role="list">
                  {product.flavors.map((f) => (
                    <li class="chip">{f}</li>
                  ))}
                </ul>
              </div>
            )
          }

          {
            product.addOns && (
              <div class="option-group">
                <p class="option-label">Add-ons</p>
                <ul class="addons" role="list">
                  {product.addOns.map((a) => (
                    <li>
                      <span>{a.label}</span>
                      <span>
                        +{money(a.price)}
                        {a.note ? ` ${a.note}` : ''}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          <div class="btn-row cta">
            <a
              class="btn"
              href={order.href}
              target={order.external ? '_blank' : undefined}
              rel={order.external ? 'noopener' : undefined}>Order this</a
            >
            <a class="btn btn-outline" href={site.links.whatsapp} target="_blank" rel="noopener">Ask a question</a>
          </div>

          <ul class="assurances" role="list">
            <li>
              <strong>Lead time:</strong> {product.leadTime}
            </li>
            <li>
              Pickup in {site.location.city} or delivery within {site.delivery.radiusMiles} miles. <a
                href="/policies/#delivery">Delivery fees</a
              >
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="details">
    <div class="container details-grid">
      <div class="detail-main">
        <h2>About this item</h2>
        <p>{product.description}</p>
        <div class="highlight">
          <p><strong>Why it's special.</strong> {product.highlight}</p>
        </div>

        {
          product.greatFor.length > 0 && (
            <>
              <h3>Great for</h3>
              <ul class="chips" role="list">
                {product.greatFor.map((g) => (
                  <li class="chip">{g}</li>
                ))}
              </ul>
            </>
          )
        }

        {
          servingGuide.length > 0 && (
            <>
              <h3>Serving guide</h3>
              <ul class="plain-list" role="list">
                {servingGuide.map((t) => (
                  <li>
                    <Icon name="users" size={16} stroke={1.5} /> {t.label} serves about {t.serves}
                  </li>
                ))}
              </ul>
            </>
          )
        }

        {
          product.notes && (
            <>
              <h3>Good to know</h3>
              <ul class="plain-list" role="list">
                {product.notes.map((n) => (
                  <li>
                    <Icon name="check" size={16} stroke={1.8} /> {n}
                  </li>
                ))}
              </ul>
            </>
          )
        }

        {
          product.faq.length > 0 && (
            <div class="faq">
              <h2>Questions</h2>
              {product.faq.map((f, i) => (
                <details open={i === 0}>
                  <summary>
                    {f.q}
                    <Icon name="plus" size={18} class="faq-icon" stroke={1.5} />
                  </summary>
                  <p>{f.a}</p>
                </details>
              ))}
            </div>
          )
        }
      </div>

      <aside class="detail-side" aria-label="Ingredients, allergens and storage">
        <div class="side-card">
          <h2 class="side-title">Ingredients</h2>
          <p>{sentenceList(product.ingredients)}.</p>
          <h2 class="side-title">Allergens</h2>
          <p><strong>Contains:</strong> {sentenceList(product.allergens)}.</p>
          <p class="tiny muted">
            Made in a kitchen that also handles wheat, dairy, eggs, soy, and tree nuts. <a href="/policies/#allergens"
              >Allergen info</a
            >
          </p>
          {
            product.dietary.length > 0 && (
              <ul class="chips" role="list">
                {product.dietary.map((d) => (
                  <li class="chip">
                    <Icon name={d === 'Halal' ? 'check-badge' : d === 'Vegetarian' ? 'leaf' : 'cup'} size={15} />
                    &nbsp;{d}
                  </li>
                ))}
              </ul>
            )
          }
        </div>
        {
          (product.storage || product.freshness) && (
            <div class="side-card">
              <h2 class="side-title">Storage &amp; freshness</h2>
              {product.storage && <p>{product.storage}</p>}
              {product.freshness && (
                <p class="fresh">
                  <Icon name="clock" size={16} stroke={1.5} /> {product.freshness}
                </p>
              )}
            </div>
          )
        }
      </aside>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section-tight related">
        <div class="container">
          <div class="related-head">
            <h2>You might also like</h2>
            <a class="text-link" href="/menu/">
              Full menu <Icon name="arrow" class="arrow" />
            </a>
          </div>
          <ProductList products={related} describe={false} />
        </div>
      </section>
    )
  }
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const main = gallery.querySelector<HTMLImageElement>('.gallery-main img');
    const thumbs = gallery.querySelectorAll<HTMLButtonElement>('.thumb');
    thumbs.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!main) return;
        main.src = btn.dataset.src || main.src;
        main.srcset = btn.dataset.srcset || '';
        thumbs.forEach((t) => {
          t.classList.toggle('is-active', t === btn);
          t.setAttribute('aria-pressed', String(t === btn));
        });
      });
    });
  });
</script>

<style>
  .product {
    padding: clamp(20px, 3vw, 36px) 0 clamp(40px, 6vw, 72px);
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 22px;
    font-size: var(--step-micro);
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--mauve);
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 8px;
    color: var(--dashed);
  }
  .crumbs a {
    color: var(--mauve);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--cocoa);
    text-decoration: underline;
  }
  .crumbs [aria-current] {
    color: var(--cocoa);
  }

  .product-grid {
    display: grid;
    gap: clamp(24px, 4vw, 56px);
    align-items: start;
  }
  @media (min-width: 900px) {
    .product-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .gallery {
      position: sticky;
      top: 90px;
    }
  }
  .gallery-main {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .badges {
    position: absolute;
    top: 14px;
    left: 14px;
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .thumbs {
    display: flex;
    gap: 10px;
    margin-top: 12px;
    flex-wrap: wrap;
  }
  .thumb {
    width: 72px;
    height: 72px;
    padding: 0;
    border-radius: var(--radius-s);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--pink);
    cursor: pointer;
    opacity: 0.75;
    transition:
      opacity 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .thumb:hover,
  .thumb.is-active {
    opacity: 1;
  }
  .thumb.is-active {
    border-color: var(--cocoa);
  }

  .summary h1 {
    margin-bottom: 10px;
  }
  .summary .lead {
    margin-bottom: 22px;
  }
  .price-block {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px 24px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 18px;
  }
  .price {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 600;
    line-height: 1;
    margin: 0;
  }
  .price-sub {
    margin: 6px 0 0;
    font-size: var(--step-small);
    color: var(--mauve);
  }
  .minimum {
    margin: 0;
    font-size: var(--step-micro);
    letter-spacing: 0.25em;
    text-transform: uppercase;
    background: var(--pink);
    padding: 8px 14px;
    border-radius: 999px;
  }

  .tiers {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 22px;
    font-size: var(--step-body-small);
  }
  .tiers th,
  .tiers td {
    text-align: left;
    padding: 9px 0;
    border-bottom: 1px solid var(--border);
  }
  .tiers tbody tr:last-child th,
  .tiers tbody tr:last-child td {
    border-bottom: 0;
  }
  .tiers thead th {
    font-size: var(--step-micro);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    font-weight: 400;
    color: var(--mauve);
  }
  .tiers tbody th {
    font-weight: 400;
  }
  .tiers td {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
  }
  .tiers td.each {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: var(--step-small);
    color: var(--mauve);
  }
  .tiers td.tier-go {
    text-align: right;
    padding-left: 10px;
    white-space: nowrap;
    width: 1%;
  }
  .tier-order {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 0 14px;
    border: 1px solid var(--cocoa);
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: var(--step-micro);
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--cocoa);
    transition:
      background-color 0.2s var(--ease),
      color 0.2s var(--ease),
      transform 0.2s var(--ease);
  }
  .tier-order:hover {
    background: var(--cocoa);
    color: var(--ivory);
    text-decoration: none;
  }
  .tier-order:active {
    transform: scale(0.97);
  }

  .option-group {
    margin-bottom: 20px;
  }
  .option-label {
    font-size: var(--step-micro);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--mauve);
    margin: 0 0 10px;
  }
  .addons li {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 0;
    border-bottom: 1px solid var(--border);
    font-size: var(--step-body-small);
  }
  .addons li span:last-child {
    white-space: nowrap;
  }

  .cta {
    margin: 26px 0 22px;
  }
  .assurances {
    display: grid;
    gap: 8px;
    font-size: var(--step-small);
    color: var(--mauve);
  }
  .assurances strong {
    color: var(--cocoa);
  }

  .details {
    padding: clamp(40px, 6vw, 72px) 0;
    border-top: 1px solid var(--border);
  }
  .details-grid {
    display: grid;
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
  }
  @media (min-width: 900px) {
    .details-grid {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    }
  }
  .detail-main h2 {
    margin-bottom: 12px;
  }
  .detail-main > p {
    font-size: var(--step-body-small);
    max-width: 62ch;
  }
  .detail-main h3 {
    font-family: var(--font-body);
    font-size: var(--step-micro);
    font-weight: 400;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--mauve);
    margin: 28px 0 12px;
  }
  .highlight {
    background: var(--pink);
    border-radius: var(--radius-s);
    padding: 16px 18px;
    margin: 18px 0 0;
    max-width: 62ch;
  }
  .highlight p {
    margin: 0;
    font-size: var(--step-body-small);
  }
  .plain-list {
    display: grid;
    gap: 8px;
    font-size: var(--step-body-small);
  }
  .plain-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .plain-list :global(svg) {
    color: var(--rose);
    flex: none;
    margin-top: 4px;
  }

  .faq {
    margin-top: 36px;
  }
  .faq details {
    border-bottom: 1px solid var(--border);
  }
  .faq details:first-of-type {
    border-top: 1px solid var(--border);
  }
  .faq summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 16px 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary :global(.faq-icon) {
    flex: none;
    color: var(--rose);
    transition: transform 0.25s var(--ease);
  }
  .faq details[open] summary :global(.faq-icon) {
    transform: rotate(45deg);
  }
  .faq details p {
    margin: 0 0 16px;
    font-size: var(--step-body-small);
  }

  .side-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-s);
    padding: 22px 22px 20px;
    margin-bottom: 14px;
  }
  .side-title {
    font-family: var(--font-body);
    font-size: var(--step-micro);
    font-weight: 400;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--mauve);
    margin: 0 0 8px;
  }
  .side-card p {
    font-size: var(--step-body-small);
    margin-bottom: 14px;
  }
  .side-card p.tiny {
    font-size: var(--step-tiny);
  }
  .side-card .chips {
    margin-top: 4px;
  }
  .fresh {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--mauve);
  }
  .fresh :global(svg) {
    color: var(--rose);
  }

  .related {
    border-top: 1px solid var(--border);
  }
  .related-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    margin-bottom: 20px;
  }
  .related-head h2 {
    margin: 0;
  }
</style>
