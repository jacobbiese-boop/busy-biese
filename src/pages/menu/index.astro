---
import Base from '../../layouts/Base.astro';
import ProductList from '../../components/ProductList.astro';
import PageHero from '../../components/PageHero.astro';
import { categories, productsIn, products } from '../../data/menu';
import { site } from '../../config/site';
import { orderLink } from '../../lib/order';
import { breadcrumbJsonLd } from '../../lib/seo';

const ld = [
  breadcrumbJsonLd(
    [
      { name: 'Home', path: '/' },
      { name: 'Menu', path: '/menu/' },
    ],
    Astro.site,
  ),
  {
    '@context': 'https://schema.org',
    '@type': 'Menu',
    name: 'Busy Biese Menu',
    hasMenuSection: categories.map((c) => ({
      '@type': 'MenuSection',
      name: c.name,
      description: c.blurb,
      hasMenuItem: productsIn(c.id).map((p) => ({
        '@type': 'MenuItem',
        name: p.name,
        description: p.short,
        url: new URL(`/menu/${p.slug}/`, Astro.site).href,
      })),
    })),
  },
];
const order = orderLink({ type: 'Menu items' });
---

<Base
  title="Menu"
  description={`The full Busy Biese menu: cinnamon rolls, mini cheesecakes, cookies, baklava, gift boxes, halal cold cut trays, and drinks. Made to order in ${site.location.city}, IL.`}
  jsonLd={ld}
>
  <PageHero
    eyebrow="The menu"
    title="Everything we make, <em>made to order</em>"
    lead={`${products.length} bakes, boxes, and trays, each made fresh for you. Tap an item to order it, or open its details for sizes, flavors, and allergens.`}
    tone="pink"
  >
    <ul class="facts" role="list">
      <li>Order {site.ordering.noticeHours} hours ahead</li>
      <li>Minimums apply</li>
      <li>Pickup or delivery within {site.delivery.radiusMiles} miles</li>
    </ul>
  </PageHero>

  <nav class="cat-nav" aria-label="Menu categories" data-cat-nav>
    <div class="container">
      <ul role="list">
        {
          categories.map((c) => (
            <li>
              <a href={`#${c.id}`} data-cat-link={c.id}>
                {c.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  <div class="menu-sections">
    {
      categories.map((c) => (
        <section id={c.id} class="menu-section" data-cat-section={c.id}>
          <div class="container">
            <header class="cat-head">
              <h2>{c.name}</h2>
              <p>{c.blurb}</p>
              {c.note && <p class="cat-note">{c.note}</p>}
            </header>
            <ProductList products={productsIn(c.id)} />
          </div>
        </section>
      ))
    }
  </div>

  <section class="section-tight">
    <div class="container">
      <div class="menu-cta panel">
        <div>
          <h2>Ready when you are.</h2>
          <p>
            Send us your order at least {site.ordering.noticeHours} hours ahead. Planning for a big group? We put
            together custom quotes for large orders.
          </p>
        </div>
        <div class="btn-row">
          <a
            class="btn"
            href={order.href}
            target={order.external ? '_blank' : undefined}
            rel={order.external ? 'noopener' : undefined}>Open the order form</a
          >
          <a class="btn btn-outline" href="/catering/">Catering &amp; large orders</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-cat-link]');
  const sections = document.querySelectorAll<HTMLElement>('[data-cat-section]');
  const setActive = (id: string) => {
    links.forEach((l) => {
      const on = l.dataset.catLink === id;
      l.classList.toggle('is-active', on);
      if (on) {
        l.setAttribute('aria-current', 'true');
        const bar = l.closest('ul');
        if (bar && bar.scrollWidth > bar.clientWidth) {
          bar.scrollTo({ left: l.offsetLeft - 16, behavior: 'smooth' });
        }
      } else {
        l.removeAttribute('aria-current');
      }
    });
  };
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) setActive((e.target as HTMLElement).dataset.catSection || '');
        });
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => io.observe(s));
  }
</script>

<style>
  /* A rose dot sits in the space before each fact. The list is pulled left by
     that space and the strip is clipped, so a dot never starts a wrapped line. */
  .facts {
    display: flex;
    flex-wrap: wrap;
    row-gap: 8px;
    margin: 4px 0 0 -48px;
    clip-path: inset(0 0 0 48px);
    font-size: var(--step-micro);
    letter-spacing: 0.25em;
    text-transform: uppercase;
  }
  .facts li {
    position: relative;
    padding-left: 48px;
  }
  .facts li::before {
    content: '·';
    position: absolute;
    left: 21px;
    color: var(--rose);
  }

  .cat-nav {
    position: sticky;
    top: 70px;
    z-index: 40;
    background: var(--ivory);
    border-bottom: 1px solid var(--border);
  }
  .cat-nav ul {
    display: flex;
    gap: 4px;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 10px 0;
    -webkit-overflow-scrolling: touch;
  }
  .cat-nav ul::-webkit-scrollbar {
    display: none;
  }
  .cat-nav a {
    display: inline-flex;
    align-items: center;
    height: 34px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid transparent;
    white-space: nowrap;
    font-size: var(--step-micro);
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--cocoa);
    text-decoration: none;
    transition:
      background-color 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }
  .cat-nav a:hover {
    border-color: var(--pink-matte);
    text-decoration: none;
  }
  .cat-nav a.is-active {
    background: var(--pink-matte);
    border-color: var(--pink-matte);
  }

  .menu-section {
    padding-block: clamp(36px, 5vw, 56px);
    scroll-margin-top: 130px;
  }
  .menu-section + .menu-section {
    border-top: 1px solid var(--border);
  }
  .cat-head {
    max-width: 620px;
    margin-bottom: clamp(18px, 2.5vw, 28px);
  }
  .cat-head h2 {
    margin-bottom: 4px;
  }
  .cat-head p {
    margin: 0;
    color: var(--mauve);
    font-size: var(--step-body-small);
  }
  .cat-note {
    margin-top: 8px !important;
    font-size: var(--step-small) !important;
  }

  .menu-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 40px;
  }
  .menu-cta h2 {
    margin-bottom: 6px;
  }
  .menu-cta p {
    margin: 0;
    max-width: 52ch;
    font-size: var(--step-body-small);
  }
</style>
