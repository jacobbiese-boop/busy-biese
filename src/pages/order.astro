---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import BeeLoader from '../components/BeeLoader.astro';
import { site } from '../config/site';
import { categories, productsIn } from '../data/menu';
import { priceLabel } from '../lib/format';
import { formUrl } from '../lib/order';
import { faqJsonLd } from '../lib/seo';

const { flatFee, flatFeeUpTo, percentOver, radiusMiles, windows } = site.delivery;
const formId = site.fillout.formId;

const faqs = [
  {
    q: 'When is my order confirmed?',
    a: 'We review every request and confirm your items, timing, and total with you. Your order and any delivery are final once we confirm.',
  },
  {
    q: 'Can I order for tomorrow?',
    a: `We need at least ${site.ordering.noticeHours} hours notice for most items (48 hours for strawberry boxes), so same-day and next-day orders are not available.`,
  },
  {
    q: 'Do you deliver?',
    a: `Yes, within ${radiusMiles} miles of ${site.location.city}. Delivery is $${flatFee} on orders up to $${flatFeeUpTo}. Above $${flatFeeUpTo}, the fee is ${percentOver}% of the order total. You can also pick up in ${site.location.city}.`,
  },
  {
    q: 'Can I order for a large event?',
    a: `Yes. For orders over our largest tray size, or about ${site.ordering.largeOrderPieces} pieces or more, send a catering inquiry and we will put together a custom quote.`,
  },
  {
    q: 'What if someone has a food allergy?',
    a: 'Everything is made in a kitchen that also handles wheat, dairy, eggs, soy, and tree nuts. Each menu item lists its allergens. If you have a severe allergy, please message us before ordering.',
  },
];
---

<Base
  title="Order"
  description={`Order from Busy Biese: made-to-order cinnamon rolls, cheesecakes, cookies, gift boxes, and halal cold cut trays. Pickup in ${site.location.city} or delivery within ${radiusMiles} miles. Please order ${site.ordering.noticeHours} hours ahead.`}
  jsonLd={faqJsonLd(faqs)}
  backToTop={false}
>
  <PageHero
    eyebrow="Order"
    title="Place an <em>order</em>"
    lead="Tell us what you would like and when you need it. We will confirm your order, timing, and total with you."
    tone="pink"
  >
    <ul class="facts" role="list">
      <li>Order {site.ordering.noticeHours} hours ahead</li>
      <li>Pickup in {site.location.city}</li>
      <li>Delivery within {radiusMiles} miles</li>
    </ul>
  </PageHero>

  <section class="section-tight form-section" id="form" aria-labelledby="form-title">
    <div class="container">
      <h2 id="form-title" class="visually-hidden">Order request form</h2>
      <p class="picked" data-picked hidden>
        <Icon name="check-badge" size={18} stroke={1.5} />
        <span data-picked-item>
          You picked <strong data-picked-name></strong>. Choose <em>Menu items</em> in the form to add it; you can change
          the size or add more.
        </span>
        <span data-picked-type hidden>Choose <strong data-picked-type-name></strong> in the form to get started.</span>
      </p>
      {
        formId ? (
          <>
            <div class="form-panel" data-form-embed>
              <div class="form-loader" data-form-loader>
                <BeeLoader size={84} />
                <p role="status">Loading the order form…</p>
              </div>
              <div
                class="form-frame"
                data-fillout-id={formId}
                data-fillout-embed-type="standard"
                data-fillout-inherit-parameters
                data-fillout-dynamic-resize
              />
            </div>
            <script is:inline src="https://server.fillout.com/embed/v1/" async />
            <p class="form-alt" data-form-alt>
              Form not showing? <a href={formUrl()} target="_blank" rel="noopener" data-order-link>Open it in a new tab</a>.
            </p>
          </>
        ) : (
          <div class="form-launch panel">
            <div>
              <p class="eyebrow">Order form</p>
              <h2>Ready? Send us your order request.</h2>
              <p class="form-note">
                Choose your items, sizes, flavors, and a pickup or delivery time. The form opens in a new tab.
              </p>
            </div>
            <a class="btn" href={formUrl()} target="_blank" rel="noopener" data-order-link>
              Open the order form
            </a>
          </div>
        )
      }
      <p class="help">
        Questions first? Message us on <a href={site.links.whatsapp} target="_blank" rel="noopener">WhatsApp</a> or <a
          href={site.links.instagram}
          target="_blank"
          rel="noopener">Instagram</a
        >{site.contact.email && <>, or email <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></>}.
      </p>
    </div>
  </section>

  <section class="section-tight essentials-wrap" aria-labelledby="good-to-know">
    <div class="container">
      <h2 id="good-to-know" class="visually-hidden">Good to know before you order</h2>
      <ul class="essentials" role="list">
        <li class="tile">
          <h3>Order ahead</h3>
          <p>
            At least {site.ordering.noticeHours} hours for most items, 48 hours for strawberry boxes. Same-day orders are
            not available.
          </p>
        </li>
        <li class="tile">
          <h3>Minimums</h3>
          <p>Most items have a small minimum, listed on each menu item. Mix flavors where noted.</p>
        </li>
        <li class="tile">
          <h3>Pickup</h3>
          <p>Pick up in {site.location.city}. We share the pickup details when we confirm your order.</p>
        </li>
        <li class="tile">
          <h3>Delivery</h3>
          <p>
            Within {radiusMiles} miles. ${flatFee} on orders up to ${flatFeeUpTo}; above that, {percentOver}% of the
            order total. Windows: {windows.map((w) => w.time).join(' or ')}.
          </p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section-tight" id="price-guide">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Quick price guide</p>
        <h2>Everything on the menu, at a glance</h2>
        <p>Tap any item for sizes, flavors, and details.</p>
      </div>
      <div class="guide">
        {
          categories.map((c) => (
            <div class="guide-group">
              <h3>{c.name}</h3>
              <ul role="list">
                {productsIn(c.id).map((p) => (
                  <li>
                    <a href={`/menu/${p.slug}/`}>{p.name}</a>
                    <span class="dots" aria-hidden="true" />
                    <span class="guide-price">{priceLabel(p)}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container-narrow">
      <div class="section-head">
        <p class="eyebrow">Good to know</p>
        <h2>Ordering questions</h2>
      </div>
      <div class="faq">
        {
          faqs.map((f, i) => (
            <details open={i === 0}>
              <summary>
                {f.q}
                <Icon name="plus" size={18} class="faq-icon" stroke={1.5} />
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
      <p class="more">
        See the full <a href="/policies/">delivery and order policy</a>, or plan a big order on our <a href="/catering/"
          >catering page</a
        >.
      </p>
    </div>
  </section>
</Base>

<script>
  const params = new URLSearchParams(window.location.search);
  const item = params.get('item')?.slice(0, 90) ?? '';
  const type = params.get('type')?.slice(0, 40) ?? '';

  // Show what was picked above the form
  const box = document.querySelector<HTMLElement>('[data-picked]');
  const itemLine = document.querySelector<HTMLElement>('[data-picked-item]');
  const typeLine = document.querySelector<HTMLElement>('[data-picked-type]');
  const itemName = document.querySelector<HTMLElement>('[data-picked-name]');
  const typeName = document.querySelector<HTMLElement>('[data-picked-type-name]');
  if (box && itemLine && typeLine && itemName && typeName) {
    if (item) {
      itemName.textContent = item;
      box.hidden = false;
    } else if (type && type !== 'Menu items') {
      typeName.textContent = type;
      itemLine.hidden = true;
      typeLine.hidden = false;
      box.hidden = false;
    }
  }

  // Keep the choice when the form opens in a new tab
  document.querySelectorAll<HTMLAnchorElement>('[data-order-link]').forEach((a) => {
    try {
      const url = new URL(a.href);
      if (type) url.searchParams.set('type', type);
      if (item) url.searchParams.set('item', item);
      a.href = url.toString();
    } catch {
      /* keep the original link */
    }
  });

  // Swap the bee loader for the form once Fillout has drawn it. Fillout sizes
  // the frame by setting a height on our container; the frame's load event
  // (plus a moment) is the fallback.
  const embed = document.querySelector<HTMLElement>('[data-form-embed]');
  const frameBox = embed?.querySelector<HTMLElement>('.form-frame');
  if (embed && frameBox) {
    const done = () => embed.classList.add('is-loaded');
    new MutationObserver((_, observer) => {
      if (frameBox.style.height) {
        observer.disconnect();
        window.setTimeout(done, 150);
      }
    }).observe(frameBox, { attributes: true, attributeFilter: ['style'] });
    const watch = (frame: HTMLIFrameElement) => frame.addEventListener('load', () => window.setTimeout(done, 1500), { once: true });
    const found = frameBox.querySelector('iframe');
    if (found) watch(found);
    else {
      const observer = new MutationObserver(() => {
        const frame = frameBox.querySelector('iframe');
        if (frame) {
          observer.disconnect();
          watch(frame);
        }
      });
      observer.observe(frameBox, { childList: true, subtree: true });
    }
    window.setTimeout(() => {
      if (!embed.classList.contains('is-loaded')) document.documentElement.classList.add('form-slow');
    }, 12000);
  }
</script>

<style>
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin-top: 4px;
    font-size: var(--step-micro);
    letter-spacing: 0.25em;
    text-transform: uppercase;
  }
  .facts li + li::before {
    content: '·';
    margin-right: 22px;
    color: var(--rose);
  }

  .picked {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    background: var(--pink);
    border-radius: var(--radius);
    padding: 12px 18px;
    margin: 0 0 14px;
    font-size: var(--step-small);
    line-height: 1.5;
  }
  .picked[hidden] {
    display: none;
  }
  .picked :global(svg) {
    margin-top: 2px;
    color: var(--rose);
    flex: none;
  }

  .essentials-wrap {
    padding-top: 0;
  }
  .essentials {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
  }
  .essentials h3 {
    font-size: var(--step-h3);
    font-weight: 600;
    margin-bottom: 6px;
  }
  .essentials p {
    margin: 0;
    font-size: var(--step-small);
    color: var(--mauve);
    line-height: 1.55;
  }

  .form-section {
    padding-top: 0;
  }
  /* The Fillout form brings its own ivory card, so it sits right on the page */
  .form-panel {
    position: relative;
    min-height: 560px;
  }
  .form-frame {
    position: relative;
    width: 100%;
    min-height: 560px;
  }
  .is-loaded,
  .is-loaded .form-frame {
    min-height: 0;
  }
  .form-loader {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 14px;
    background: var(--ivory);
    border-radius: var(--radius);
    transition:
      opacity 0.4s var(--ease),
      visibility 0s linear 0.4s;
  }
  .form-loader p {
    margin: 0;
    color: var(--mauve);
    font-size: var(--step-small);
    letter-spacing: 0.08em;
  }
  .is-loaded .form-loader {
    opacity: 0;
    visibility: hidden;
  }
  .form-alt {
    margin: 12px 4px 0;
    color: var(--mauve);
    font-size: var(--step-small);
  }
  :global(html.form-slow) .form-alt {
    color: var(--cocoa);
    font-weight: 500;
  }
  .form-launch {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 40px;
  }
  .form-launch h2 {
    max-width: 22ch;
    margin-bottom: 8px;
  }
  .form-note {
    margin: 0;
    max-width: 46ch;
    font-size: var(--step-body-small);
  }
  .help {
    margin: 18px 4px 0;
    color: var(--mauve);
    font-size: var(--step-small);
  }

  .guide {
    display: grid;
    gap: 18px 40px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
  }
  .guide-group h3 {
    font-family: var(--font-body);
    font-size: var(--step-micro);
    font-weight: 400;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--mauve);
    padding-bottom: 10px;
    border-bottom: 1px solid var(--cocoa);
    margin: 0 0 4px;
  }
  .guide-group li {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 9px 0;
    border-bottom: 1px solid var(--border);
    font-size: var(--step-body-small);
  }
  .guide-group a {
    text-decoration: none;
    color: var(--cocoa);
  }
  .guide-group a:hover {
    color: var(--rose-text);
    text-decoration: underline;
  }
  .dots {
    flex: 1;
    border-bottom: 1px dotted var(--dashed);
    transform: translateY(-4px);
    min-width: 12px;
  }
  .guide-price {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    white-space: nowrap;
  }

  .faq details {
    border-bottom: 1px solid var(--border);
  }
  .faq details:first-of-type {
    border-top: 1px solid var(--border);
  }
  .faq summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 16px 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary :global(.faq-icon) {
    flex: none;
    color: var(--rose);
    transition: transform 0.25s var(--ease);
  }
  .faq details[open] summary :global(.faq-icon) {
    transform: rotate(45deg);
  }
  .faq details p {
    margin: 0 0 16px;
    font-size: var(--step-body-small);
  }
  .more {
    margin-top: 24px;
    color: var(--mauve);
    font-size: var(--step-small);
  }
</style>
