---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
import { categories, productsIn } from '../data/menu';
import { priceLabel } from '../lib/format';
import { orderLink } from '../lib/order';
import { faqJsonLd } from '../lib/seo';

const { flatFee, flatFeeUpTo, percentOver, radiusMiles, windows } = site.delivery;
const formId = site.fillout.formId;

const faqs = [
  {
    q: 'When is my order confirmed?',
    a: 'We review every request and confirm your items, timing, and total with you. Your order and any delivery are final once we confirm.',
  },
  {
    q: 'Can I order for tomorrow?',
    a: `We need at least ${site.ordering.noticeHours} hours notice for most items (48 hours for strawberry boxes), so same-day and next-day orders are not available.`,
  },
  {
    q: 'Do you deliver?',
    a: `Yes, within ${radiusMiles} miles of ${site.location.city}. Delivery is $${flatFee} on orders up to $${flatFeeUpTo}. Above $${flatFeeUpTo}, the fee is ${percentOver}% of the order total. You can also pick up in ${site.location.city}.`,
  },
  {
    q: 'Can I order for a large event?',
    a: `Yes. For orders over our largest tray size, or about ${site.ordering.largeOrderPieces} pieces or more, send a catering inquiry and we will put together a custom quote.`,
  },
  {
    q: 'What if someone has a food allergy?',
    a: 'Everything is made in a kitchen that also handles wheat, dairy, eggs, soy, and tree nuts. Each menu item lists its allergens. If you have a severe allergy, please message us before ordering.',
  },
];
---

<Base
  title="Order"
  description={`Order from Busy Biese: made-to-order cinnamon rolls, cheesecakes, cookies, gift boxes, and halal cold cut trays. Pickup in ${site.location.city} or delivery within ${radiusMiles} miles. Please order ${site.ordering.noticeHours} hours ahead.`}
  jsonLd={faqJsonLd(faqs)}
>
  <PageHero
    eyebrow="Order"
    title="Place an <em>order</em>"
    lead="Tell us what you would like and when you need it. We will confirm your order, timing, and total with you."
    tone="pink"
  >
    <p class="picked" data-picked hidden>
      <Icon name="check-badge" size={18} stroke={1.5} />
      <span>You picked <strong data-picked-name></strong>. Add it to your order below.</span>
    </p>
  </PageHero>

  <section class="section-tight essentials-wrap">
    <div class="container">
      <ul class="essentials" role="list">
        <li class="tile">
          <h2>Order ahead</h2>
          <p>
            At least {site.ordering.noticeHours} hours for most items, 48 hours for strawberry boxes. Same-day orders are
            not available.
          </p>
        </li>
        <li class="tile">
          <h2>Minimums</h2>
          <p>Most items have a small minimum, listed on each menu item. Mix flavors where noted.</p>
        </li>
        <li class="tile">
          <h2>Pickup</h2>
          <p>Pick up in {site.location.city}. We share the pickup details when we confirm your order.</p>
        </li>
        <li class="tile">
          <h2>Delivery</h2>
          <p>
            Within {radiusMiles} miles. ${flatFee} on orders up to ${flatFeeUpTo}; above that, {percentOver}% of the
            order total. Windows: {windows.map((w) => w.time).join(' or ')}.
          </p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section-tight form-section" id="form">
    <div class="container">
      {
        formId ? (
          <div class="form-panel">
            <div
              style="width:100%;min-height:640px;"
              data-fillout-id={formId}
              data-fillout-embed-type="standard"
              data-fillout-inherit-parameters
              data-fillout-dynamic-resize
            />
            <script is:inline src="https://server.fillout.com/embed/v1/" async />
          </div>
        ) : (
          <div class="form-launch panel">
            <div>
              <p class="eyebrow">Order form</p>
              <h2>Ready? Send us your order request.</h2>
              <p class="form-note">
                Choose your items, sizes, flavors, and a pickup or delivery time. The form opens in a new tab.
              </p>
            </div>
            <a class="btn" href={orderLink().href} target="_blank" rel="noopener" data-order-link>
              Open the order form
            </a>
          </div>
        )
      }
      <p class="help">
        Questions first? Message us on <a href={site.links.whatsapp} target="_blank" rel="noopener">WhatsApp</a> or <a
          href={site.links.instagram}
          target="_blank"
          rel="noopener">Instagram</a
        >{site.contact.email && <>, or email <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></>}.
      </p>
    </div>
  </section>

  <section class="section-tight" id="price-guide">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Quick price guide</p>
        <h2>Everything on the menu, at a glance</h2>
        <p>Tap any item for sizes, flavors, and details.</p>
      </div>
      <div class="guide">
        {
          categories.map((c) => (
            <div class="guide-group">
              <h3>{c.name}</h3>
              <ul role="list">
                {productsIn(c.id).map((p) => (
                  <li>
                    <a href={`/menu/${p.slug}/`}>{p.name}</a>
                    <span class="dots" aria-hidden="true" />
                    <span class="guide-price">{priceLabel(p)}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container-narrow">
      <div class="section-head">
        <p class="eyebrow">Good to know</p>
        <h2>Ordering questions</h2>
      </div>
      <div class="faq">
        {
          faqs.map((f, i) => (
            <details open={i === 0}>
              <summary>
                {f.q}
                <Icon name="plus" size={18} class="faq-icon" stroke={1.5} />
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
      <p class="more">
        See the full <a href="/policies/">delivery and order policy</a>, or plan a big order on our <a href="/catering/"
          >catering page</a
        >.
      </p>
    </div>
  </section>
</Base>

<script>
  const item = new URLSearchParams(window.location.search).get('item');
  if (item) {
    const box = document.querySelector<HTMLElement>('[data-picked]');
    const name = document.querySelector<HTMLElement>('[data-picked-name]');
    if (box && name) {
      name.textContent = item.slice(0, 80);
      box.hidden = false;
    }
    document.querySelectorAll<HTMLAnchorElement>('[data-order-link]').forEach((a) => {
      try {
        const url = new URL(a.href);
        url.searchParams.set('item', item.slice(0, 80));
        a.href = url.toString();
      } catch {
        /* keep the original link */
      }
    });
  }
</script>

<style>
  .picked {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--ivory);
    border-radius: 999px;
    padding: 10px 18px;
    margin: 18px 0 0;
    font-size: var(--step-small);
  }
  .picked[hidden] {
    display: none;
  }
  .picked :global(svg) {
    color: var(--rose);
    flex: none;
  }

  .essentials-wrap {
    padding-top: 0;
  }
  .essentials {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
  }
  .essentials h2 {
    font-size: var(--step-h3);
    font-weight: 600;
    margin-bottom: 6px;
  }
  .essentials p {
    margin: 0;
    font-size: var(--step-small);
    color: var(--mauve);
    line-height: 1.55;
  }

  .form-section {
    padding-top: 0;
  }
  .form-panel {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: clamp(16px, 3vw, 32px);
  }
  .form-launch {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 40px;
  }
  .form-launch h2 {
    max-width: 22ch;
    margin-bottom: 8px;
  }
  .form-note {
    margin: 0;
    max-width: 46ch;
    font-size: var(--step-body-small);
  }
  .help {
    margin: 18px 4px 0;
    color: var(--mauve);
    font-size: var(--step-small);
  }

  .guide {
    display: grid;
    gap: 18px 40px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
  }
  .guide-group h3 {
    font-family: var(--font-body);
    font-size: var(--step-micro);
    font-weight: 400;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--mauve);
    padding-bottom: 10px;
    border-bottom: 1px solid var(--cocoa);
    margin: 0 0 4px;
  }
  .guide-group li {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 9px 0;
    border-bottom: 1px solid var(--border);
    font-size: var(--step-body-small);
  }
  .guide-group a {
    text-decoration: none;
    color: var(--cocoa);
  }
  .guide-group a:hover {
    color: var(--rose-text);
    text-decoration: underline;
  }
  .dots {
    flex: 1;
    border-bottom: 1px dotted var(--dashed);
    transform: translateY(-4px);
    min-width: 12px;
  }
  .guide-price {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    white-space: nowrap;
  }

  .faq details {
    border-bottom: 1px solid var(--border);
  }
  .faq details:first-of-type {
    border-top: 1px solid var(--border);
  }
  .faq summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 16px 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary :global(.faq-icon) {
    flex: none;
    color: var(--rose);
    transition: transform 0.25s var(--ease);
  }
  .faq details[open] summary :global(.faq-icon) {
    transform: rotate(45deg);
  }
  .faq details p {
    margin: 0 0 16px;
    font-size: var(--step-body-small);
  }
  .more {
    margin-top: 24px;
    color: var(--mauve);
    font-size: var(--step-small);
  }
</style>
