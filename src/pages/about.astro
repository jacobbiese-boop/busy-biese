---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import Gallery from '../components/Gallery.astro';
import Logo from '../components/Logo.astro';
import { site } from '../config/site';
import { gallery } from '../data/menu';
import { hasPhoto } from '../lib/photos';
import { bakeryJsonLd, breadcrumbJsonLd } from '../lib/seo';

const hasGallery = gallery.some((g) => hasPhoto(g.photo));

const values = [
  {
    title: 'Made with care',
    text: 'Every recipe is made with care and intention, from the first batch to the final ribbon.',
  },
  {
    title: 'Small batches, made to order',
    text: 'Nothing sits on a shelf. We bake for your order and your date, so it arrives fresh.',
  },
  {
    title: 'Meant to be shared',
    text: 'Small gestures, a pastry, a coffee, a shared meal, create meaningful moments.',
  },
  {
    title: 'Rooted in community',
    text: 'Gathering around food strengthens community. That is the whole point.',
  },
];
---

<Base
  title="Our Story"
  description={`Busy Biese is a family, small-batch bakery in ${site.location.city}, IL, baking since ${site.established}. Biese is our family name, and yes, it sounds like "bees."`}
  jsonLd={[
    bakeryJsonLd(Astro.site),
    breadcrumbJsonLd(
      [
        { name: 'Home', path: '/' },
        { name: 'Our Story', path: '/about/' },
      ],
      Astro.site,
    ),
  ]}
>
  <PageHero
    eyebrow="Our story"
    title="A family name, <em>a full kitchen</em>"
    lead={`Busy Biese is a small-batch bakery in ${site.location.city}, Illinois. Biese is our family name, and yes, it sounds like “bees.”`}
    tone="pink"
  />

  <section class="section-tight">
    <div class="container split">
      <div class="story prose">
        <div class="story-mark"><Logo size="large" /></div>
        <p class="big">
          Busy Biese began in {site.established} with a belief we still bake by: food has the power to bring people
          together.
        </p>
        <p>
          Today we make everything to order in small batches, from brown butter cookies and cinnamon rolls to stuffed
          date boxes for Ramadan and halal cold cut trays for the office. Each order is made with care and packed to be
          given, shared, and enjoyed together.
        </p>
        <p>
          The bee is our symbol for a reason. Every bee contributes to something greater than itself. We try to run
          our kitchen the same way: thoughtful work, done with intention, for the people around us.
        </p>
      </div>
      <div class="story-art" data-reveal>
        <Photo
          names={['cake-new-chapter', 'cinnamon-rolls']}
          alt="A white buttercream cake with ribbon bows, made for a celebration"
          ratio="4 / 5"
          sizes="(min-width: 900px) 42vw, 100vw"
        />
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="values panel">
        <div class="section-head">
          <p class="eyebrow">What we believe</p>
          <h2>Four ideas behind every box that leaves our kitchen</h2>
        </div>
        <div class="grid grid-4">
          {
            values.map((v, i) => (
              <article class="value" data-reveal>
                <span class="value-num">{i + 1}</span>
                <h3>{v.title}</h3>
                <p>{v.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {
    hasGallery && (
      <section class="section-tight" id="gallery">
        <div class="container">
          <div class="section-head">
            <p class="eyebrow">Things we have made</p>
            <h2>From recent orders</h2>
          </div>
          <Gallery variant="grid" />
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container-narrow vision">
      <p class="eyebrow">What's next</p>
      <h2>A place of our own</h2>
      <p class="lead">
        Our hope is to grow into a welcoming space of our own: a place where neighbors can gather, work, meet, and
        celebrate over thoughtfully made food. For now, it starts with every order.
      </p>
      <div class="btn-row">
        <a class="btn" href="/menu/">Explore the menu</a>
        <a class="btn btn-outline" href="/order/">Start an order</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .story-mark {
    margin-bottom: 26px;
  }
  .story .big {
    font-family: var(--font-display);
    font-size: var(--step-h2);
    font-weight: 500;
    line-height: 1.25;
  }
  .story p {
    font-size: var(--step-body-small);
  }
  @media (min-width: 700px) {
    .story p {
      font-size: 1.0625rem;
    }
    .story .big {
      font-size: 1.875rem;
    }
  }
  .story-art :global(.photo) {
    border-radius: var(--radius);
    max-width: 520px;
    margin-inline: auto;
  }

  .values .section-head h2 {
    max-width: 24ch;
  }
  .value {
    background: var(--ivory);
    border-radius: var(--radius-s);
    padding: 22px 22px 18px;
  }
  .value-num {
    display: block;
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 500;
    line-height: 1;
    color: var(--rose);
    margin-bottom: 12px;
  }
  .value h3 {
    margin-bottom: 6px;
  }
  .value p {
    margin: 0;
    font-size: var(--step-small);
    color: var(--mauve);
    line-height: 1.55;
  }

  .vision {
    text-align: center;
  }
  .vision .lead {
    margin-inline: auto;
    margin-bottom: 26px;
  }
  .vision .btn-row {
    justify-content: center;
  }
</style>
