---
import Base from '../layouts/Base.astro';
import Bee from '../components/Bee.astro';
---

<Base title="Page not found" description="We could not find that page." noindex>
  <section class="nf">
    <div class="container-narrow">
      <div class="nf-panel panel">
        <Bee variant="motion" size={120} class="nf-bee" />
        <p class="eyebrow">Error 404</p>
        <h1>We couldn’t find that page.</h1>
        <p class="lead">It may have moved when we refreshed the site. Try one of these instead.</p>
        <div class="btn-row">
          <a class="btn" href="/menu/">See the menu</a>
          <a class="btn btn-outline" href="/order/">Start an order</a>
          <a class="btn btn-outline" href="/">Home</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    padding: clamp(40px, 8vw, 120px) 0;
  }
  .nf-panel {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .nf :global(.nf-bee) {
    margin-bottom: 18px;
  }
  .nf .lead {
    margin-inline: auto;
  }
  .nf .btn-row {
    justify-content: center;
    margin-top: 10px;
  }
</style>
