---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ProductList from '../components/ProductList.astro';
import Photo from '../components/Photo.astro';
import { site } from '../config/site';
import { products, productsIn, getProduct } from '../data/menu';
import { money, each } from '../lib/format';
import { orderLink } from '../lib/order';
import { breadcrumbJsonLd } from '../lib/seo';

const savory = productsIn('sandwiches');
const sliders = getProduct('cold-cut-slider-tray');
const boutique = getProduct('cold-cut-boutique-box');
const boutiqueTier = boutique?.tiers[0];

// Largest size of each sweet item, pulled straight from the menu data.
const dessertTrays = products
  .filter((p) => ['pastries', 'cookies', 'cheesecakes', 'gift-boxes'].includes(p.category))
  .map((p) => {
    const counted = p.tiers.filter((t) => t.qty);
    if (!counted.length) return null;
    const top = counted.reduce((a, b) => ((b.qty ?? 0) > (a.qty ?? 0) ? b : a));
    return { product: p, tier: top };
  })
  .filter((x): x is NonNullable<typeof x> => x !== null);

const { radiusMiles, windows } = site.delivery;
const order = orderLink();
---

<Base
  title="Catering & Large Orders"
  description={`Halal cold cut slider trays, boxed lunches, and dessert trays for meetings, parties, and community events in and around ${site.location.city}, IL. Delivery within ${radiusMiles} miles.`}
  jsonLd={breadcrumbJsonLd(
    [
      { name: 'Home', path: '/' },
      { name: 'Catering', path: '/catering/' },
    ],
    Astro.site,
  )}
>
  <PageHero
    eyebrow="Catering & large orders"
    title="Feed the whole room, <em>beautifully</em>"
    lead={`Halal cold cut slider trays and boxed lunches for meetings and events, plus dessert trays to round it out. Pickup in ${site.location.city} or delivery within ${radiusMiles} miles.`}
    tone="pink"
  >
    <div class="btn-row">
      <a
        class="btn"
        href={order.href}
        target={order.external ? '_blank' : undefined}
        rel={order.external ? 'noopener' : undefined}>Start a catering order</a
      >
      <a class="btn btn-outline" href={site.links.whatsapp} target="_blank" rel="noopener">Ask about a custom quote</a>
    </div>
  </PageHero>

  <section class="section-tight">
    <div class="container">
      <ul class="cater-gallery" role="list">
        <li><Photo name="catering-trays" alt="Two catering trays of dessert with pistachio and rose petals" ratio="4 / 5" sizes="(min-width: 900px) 33vw, 100vw" eager /></li>
        <li><Photo name="dessert-box" alt="A box of mini dessert cups for a party" ratio="4 / 5" sizes="(min-width: 900px) 33vw, 50vw" /></li>
        <li><Photo name="market-table" alt="A table of packaged desserts set up for an event" ratio="4 / 5" sizes="(min-width: 900px) 33vw, 50vw" /></li>
      </ul>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Savory</p>
        <h2>Sandwiches &amp; trays</h2>
        <p>Every cold cut we serve is 100% halal-certified.</p>
      </div>
      <ProductList products={savory} />
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="guide panel split">
        <div>
          <p class="eyebrow">Serving guide</p>
          <h2>How many sliders do I need?</h2>
          <p>Plan on about two sliders per person. Here is how our trays usually stretch.</p>
          {
            boutiqueTier && boutiqueTier.qty && (
              <p>
                For small teams, the Boutique Box brings {boutiqueTier.qty} full meals (sub, chips, and pickle) for{' '}
                {money(boutiqueTier.price)}, which works out to {money(boutiqueTier.price / boutiqueTier.qty)} a person.
              </p>
            )
          }
        </div>
        <div class="guide-card">
          <table>
            <caption class="visually-hidden">Slider tray serving guide</caption>
            <thead>
              <tr>
                <th scope="col">Tray</th>
                <th scope="col">Serves about</th>
                <th scope="col">Price</th>
              </tr>
            </thead>
            <tbody>
              {
                sliders?.tiers.map((t) => (
                  <tr>
                    <th scope="row">{t.label}</th>
                    <td>{t.serves ?? ''}</td>
                    <td>{money(t.price)}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
          {
            sliders?.addOns && (
              <p class="guide-foot">
                Add-ons: {sliders.addOns.map((a) => `${a.label.toLowerCase()} ${money(a.price)}${a.note ? ' ' + a.note : ''}`).join(', ')}.
              </p>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Sweet</p>
        <h2>Dessert trays for a crowd</h2>
        <p>Our largest sizes, made for events. Mix flavors where noted on each item.</p>
      </div>
      <ul class="trays" role="list">
        {
          dessertTrays.map(({ product, tier }) => (
            <li data-reveal>
              <a href={`/menu/${product.slug}/`}>
                <span class="tray-name">{product.name}</span>
                <span class="tray-size">{tier.label}</span>
                <span class="tray-price">
                  {money(tier.price)}
                  {tier.qty && <small>{each(tier.price / tier.qty)} each</small>}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Planning tips</p>
        <h2>For a smooth event</h2>
      </div>
      <div class="grid grid-4 tips">
        <article class="tile">
          <h3>Book early</h3>
          <p>
            We need {site.ordering.noticeHours} hours for most orders. For 48 sliders or more, a week ahead is best.
          </p>
        </article>
        <article class="tile">
          <h3>Going big?</h3>
          <p>
            For orders beyond our largest trays, or about {site.ordering.largeOrderPieces} pieces or more, we will put
            together a custom quote.
          </p>
        </article>
        <article class="tile">
          <h3>Delivery windows</h3>
          <p>
            We deliver within {radiusMiles} miles in two windows: {windows.map((w) => `${w.label.toLowerCase()} (${w.time})`).join(' and ')}.
          </p>
        </article>
        <article class="tile">
          <h3>Halal, always</h3>
          <p>All of our cold cuts are 100% halal-certified, so everyone at the table can dig in.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="cta-band panel">
        <div>
          <h2>Tell us about your event.</h2>
          <p>Share your date, headcount, and what you have in mind. We will confirm the details and timing with you.</p>
        </div>
        <div class="btn-row">
          <a
            class="btn"
            href={order.href}
            target={order.external ? '_blank' : undefined}
            rel={order.external ? 'noopener' : undefined}>Start an order</a
          >
          <a class="btn btn-outline" href={site.links.whatsapp} target="_blank" rel="noopener">Message us</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .cater-gallery {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(3, 1fr);
  }
  .cater-gallery :global(.photo) {
    border-radius: var(--radius-s);
  }
  @media (max-width: 699px) {
    .cater-gallery {
      grid-template-columns: repeat(2, 1fr);
    }
    .cater-gallery li:first-child {
      grid-column: span 2;
    }
    .cater-gallery li:first-child :global(.photo) {
      aspect-ratio: 4 / 3 !important;
    }
  }

  .guide {
    align-items: center;
  }
  .guide p {
    font-size: var(--step-body-small);
  }
  .guide-card {
    background: var(--ivory);
    border-radius: var(--radius-s);
    padding: clamp(18px, 3vw, 28px);
  }
  .guide-card table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step-body-small);
  }
  .guide-card th,
  .guide-card td {
    text-align: left;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
  }
  .guide-card thead th {
    font-size: var(--step-micro);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    font-weight: 400;
    color: var(--mauve);
  }
  .guide-card tbody th {
    font-weight: 400;
  }
  .guide-card td:last-child {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
  }
  .guide-card tbody tr:last-child th,
  .guide-card tbody tr:last-child td {
    border-bottom: 0;
  }
  .guide-foot {
    margin: 14px 0 0;
    font-size: var(--step-small);
    color: var(--mauve);
  }

  .trays {
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
  }
  .trays a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2px 16px;
    padding: 16px 18px;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-s);
    text-decoration: none;
    color: var(--cocoa);
    transition:
      background-color 0.25s var(--ease),
      border-color 0.25s var(--ease);
  }
  .trays a:hover {
    background: var(--pink-matte);
    border-color: var(--pink-matte);
    text-decoration: none;
  }
  .tray-name {
    font-family: var(--font-display);
    font-size: var(--step-h3);
    font-weight: 600;
    line-height: 1.2;
  }
  .tray-size {
    grid-column: 1;
    font-size: var(--step-small);
    color: var(--mauve);
  }
  .trays a:hover .tray-size {
    color: var(--cocoa);
  }
  .tray-price {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    text-align: right;
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.1;
  }
  .tray-price small {
    display: block;
    font-family: var(--font-body);
    font-size: var(--step-tiny);
    font-weight: 300;
    color: var(--mauve);
    margin-top: 2px;
  }
  .trays a:hover .tray-price small {
    color: var(--cocoa);
  }

  .tips h3 {
    margin-bottom: 8px;
  }
  .tips p {
    margin: 0;
    font-size: var(--step-small);
    color: var(--mauve);
    line-height: 1.55;
  }

  .cta-band {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 40px;
  }
  .cta-band h2 {
    margin-bottom: 6px;
  }
  .cta-band p {
    margin: 0;
    max-width: 48ch;
    font-size: var(--step-body-small);
  }
</style>
