---
import Base from '../layouts/Base.astro';
import ProductList from '../components/ProductList.astro';
import Gallery from '../components/Gallery.astro';
import Photo from '../components/Photo.astro';
import Bee from '../components/Bee.astro';
import Icon from '../components/Icon.astro';
import { products, getProduct, gallery } from '../data/menu';
import { hasPhoto } from '../lib/photos';
import { site } from '../config/site';
import { bakeryJsonLd } from '../lib/seo';

const featuredSlugs = [
  'cinnamon-rolls',
  'mini-cheesecakes',
  'brown-butter-chocolate-chip-cookies',
  'house-baklava',
  'cold-cut-slider-tray',
  'small-date-boxes',
];
const featured = featuredSlugs.map((slug) => getProduct(slug)).filter((p): p is NonNullable<typeof p> => Boolean(p));
const sliders = getProduct('cold-cut-slider-tray');
const count = products.length;
const hasGallery = gallery.some((g) => hasPhoto(g.photo));
---

<Base jsonLd={bakeryJsonLd(Astro.site)}>
  <!-- Hero -->
  <section class="hero-wrap">
    <div class="container">
      <div class="hero panel">
        <div class="hero-copy">
          <p class="eyebrow">Made to order · {site.location.city}, {site.location.region}</p>
          <h1>Baked to order, made to be shared</h1>
          <p class="hero-lead">
            Cinnamon rolls, mini cheesecakes, brown butter cookies, baklava, gift boxes, and halal cold cut trays,
            made fresh for your gatherings, your gifts, and your everyday treats.
          </p>
          <div class="btn-row">
            <a class="btn" href="/order/">Order now</a>
            <a class="btn btn-outline" href="/menu/">See the menu</a>
          </div>
        </div>
        <div class="hero-bee">
          <Bee variant="motion" size={220} class="hero-bee-svg" />
        </div>
      </div>
    </div>
  </section>

  <!-- What we bake -->
  <section class="section-tight">
    <div class="container">
      <div class="head-row">
        <div class="section-head">
          <p class="eyebrow">What we bake</p>
          <h2>From our kitchen</h2>
          <p>Tap an item to order it. Everything is baked fresh for you.</p>
        </div>
        <a class="text-link" href="/menu/">Full menu, {count} items <Icon name="arrow" class="arrow" /></a>
      </div>
      <ProductList products={featured} columns={2} />
    </div>
  </section>

  <!-- Gallery -->
  {
    hasGallery && (
      <section class="section-tight">
        <div class="container">
          <div class="section-head">
            <p class="eyebrow">Things we have made</p>
            <h2>A few from recent orders</h2>
          </div>
          <Gallery variant="mosaic" limit={9} />
          <p class="gallery-more">
            <a class="text-link" href="/about/#gallery">
              See more <Icon name="arrow" class="arrow" />
            </a>
          </p>
        </div>
      </section>
    )
  }

  <!-- How ordering works -->
  <section class="section-tight">
    <div class="container">
      <div class="how panel">
        <div class="section-head">
          <p class="eyebrow">How it works</p>
          <h2>Ordering is simple</h2>
          <p>Everything is baked fresh for you, so we ask for a little notice.</p>
        </div>
        <ol class="steps" role="list">
          <li data-reveal>
            <span class="step-num">1</span>
            <h3>Pick your treats</h3>
            <p>Browse the menu and choose your sizes. Most items have a small minimum, listed on each item.</p>
          </li>
          <li data-reveal>
            <span class="step-num">2</span>
            <h3>Send your order</h3>
            <p>
              Fill out our short order form at least {site.ordering.noticeHours} hours ahead. Strawberry boxes need 48
              hours.
            </p>
          </li>
          <li data-reveal>
            <span class="step-num">3</span>
            <h3>We confirm, you enjoy</h3>
            <p>
              We confirm your order and timing. Pick up in {site.location.city}, or we deliver within {
                site.delivery.radiusMiles
              } miles.
            </p>
          </li>
        </ol>
        <div class="btn-row">
          <a class="btn" href="/order/">Order now</a>
          <a class="btn btn-outline" href="/policies/">Delivery details</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Catering -->
  <section class="section">
    <div class="container split">
      <div class="catering-art" data-reveal>
        <Photo
          names={['catering-trays', 'dessert-box']}
          alt="Catering trays of dessert, ready for an event"
          ratio="1 / 1"
          sizes="(min-width: 900px) 46vw, 100vw"
        />
      </div>
      <div>
        <p class="eyebrow">Catering &amp; large orders</p>
        <h2>Trays and boxes for meetings, parties, and community events</h2>
        <p class="lead">
          Halal cold cut slider trays, boxed lunches for small teams, and dessert trays to round it out. Tell us the
          date and the headcount and we will put the rest together.
        </p>
        <ul class="checks" role="list">
          {
            sliders?.tiers
              .filter((t) => t.serves)
              .map((t) => (
                <li>
                  <Icon name="check" size={16} stroke={1.8} /> {t.label} serves about {t.serves}
                </li>
              ))
          }
        </ul>
        <div class="btn-row">
          <a class="btn" href="/catering/">Plan your catering</a>
          <a class="btn btn-outline" href="/menu/#sandwiches">See the trays</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Occasions -->
  <section class="section-tight">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Made for moments</p>
        <h2>{site.tagline}</h2>
      </div>
      <div class="grid grid-4">
        <article class="tile occasion" data-reveal>
          <h3>Gifting</h3>
          <p>Date boxes, baklava, and cookie boxes, packed beautifully and ready to give.</p>
        </article>
        <article class="tile occasion" data-reveal>
          <h3>Gatherings</h3>
          <p>Mini cheesecakes and dessert trays for showers, birthdays, and family nights.</p>
        </article>
        <article class="tile occasion" data-reveal>
          <h3>Office lunches</h3>
          <p>Boutique lunch boxes and slider trays that make feeding a team easy.</p>
        </article>
        <article class="tile occasion" data-reveal>
          <h3>Ramadan &amp; Eid</h3>
          <p>Seasonal date boxes and sweets for iftars, Eid visits, and favors.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Story -->
  <section class="section">
    <div class="container split reverse">
      <div class="story-art" data-reveal>
        <Photo names={['dessert-box', 'cake-new-chapter']} alt="A box of mini desserts held up in the sun" ratio="1 / 1" sizes="(min-width: 900px) 40vw, 100vw" />
      </div>
      <div class="story-copy">
        <p class="eyebrow">Our name</p>
        <h2>Biese is our family name. <em>And yes, it sounds like “bees.”</em></h2>
        <p class="lead">
          Busy Biese is a family bakery in {site.location.city}. Since {site.established} we have baked in small
          batches, made every order fresh, and packed each one like a gift.
        </p>
        <p class="muted">
          We believe good things happen when people come together. A pan of cinnamon rolls, a box of dates, a tray
          for the office. Small moments, shared.
        </p>
        <a class="text-link" href="/about/">Read our story <Icon name="arrow" class="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- Community -->
  <section class="section-tight">
    <div class="container">
      <div class="community panel">
        <div>
          <p class="eyebrow">Stay in the loop</p>
          <h2>Follow along for seasonal boxes and new bakes.</h2>
        </div>
        <div class="btn-row">
          <a class="btn" href={site.links.instagram} target="_blank" rel="noopener">
            {site.links.instagramHandle}
          </a>
          <a class="btn btn-outline" href={site.links.whatsapp} target="_blank" rel="noopener">WhatsApp community</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero-wrap {
    padding-top: clamp(16px, 2.5vw, 28px);
  }
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 32px;
    padding: clamp(32px, 5vw, 56px) clamp(20px, 4vw, 48px);
  }
  .hero-copy {
    flex: 1 1 300px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .hero-copy .eyebrow,
  .hero-copy h1,
  .hero-copy p {
    margin: 0;
  }
  .hero-copy h1 {
    max-width: 16ch;
  }
  .hero-lead {
    font-size: var(--step-body-small);
    line-height: 1.6;
    max-width: 440px;
  }
  .hero-copy .btn-row {
    margin-top: 6px;
  }
  .hero-bee {
    flex: 0 1 260px;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .hero-bee :global(.hero-bee-svg) {
    width: clamp(110px, 20vw, 220px);
    height: auto;
    animation: float 7s ease-in-out infinite;
  }
  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }
  @media (max-width: 599px) {
    .hero {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 12px;
    }
    .hero-bee {
      flex: none;
      align-self: flex-end;
    }
  }

  .head-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 14px 32px;
  }
  .head-row .section-head {
    margin-bottom: clamp(20px, 3vw, 32px);
  }
  .head-row .text-link {
    margin-bottom: clamp(24px, 3vw, 36px);
  }

  .gallery-more {
    margin: 24px 0 0;
  }

  .how {
    padding: clamp(32px, 5vw, 56px) clamp(20px, 4vw, 48px);
  }
  .steps {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    margin: 0 0 32px;
  }
  .steps li {
    background: var(--ivory);
    border-radius: var(--radius-s);
    padding: 22px 22px 18px;
  }
  .step-num {
    display: block;
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 500;
    line-height: 1;
    color: var(--rose);
    margin-bottom: 12px;
  }
  .steps h3 {
    margin-bottom: 6px;
  }
  .steps p {
    margin: 0;
    font-size: var(--step-small);
    color: var(--mauve);
  }

  .catering-art :global(.photo),
  .story-art :global(.photo) {
    border-radius: var(--radius);
    max-width: 560px;
    margin-inline: auto;
  }
  .checks {
    display: grid;
    gap: 8px;
    margin: 0 0 26px;
    font-size: var(--step-body-small);
  }
  .checks li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .checks :global(svg) {
    color: var(--rose);
    flex: none;
  }

  .occasion h3 {
    margin-bottom: 8px;
  }
  .occasion p {
    margin: 0;
    font-size: var(--step-small);
    color: var(--mauve);
    line-height: 1.55;
  }

  .story-copy h2 :global(em) {
    font-weight: 400;
  }

  .community {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 40px;
  }
  .community h2 {
    margin: 0;
    max-width: 22ch;
  }
</style>
