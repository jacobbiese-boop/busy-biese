---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import { products, categories, productsIn, kitchenGallery, getProduct } from '../data/menu';
import { money, startingPrice } from '../lib/format';
import { site } from '../config/site';
import { hasPhoto } from '../lib/photos';
import { bakeryJsonLd } from '../lib/seo';

const favorites = products.filter((p) => p.featured && p.category !== 'sandwiches');
const gallery = kitchenGallery.filter((g) => hasPhoto(g.photo));
const sliders = getProduct('cold-cut-slider-tray');
const tickerItems = [
  'Cinnamon rolls',
  'Mini cheesecakes',
  'Brown butter cookies',
  'House baklava',
  'Cake pops',
  'Nutella brownies',
  'Date boxes',
  'Halal slider trays',
  'Salted maple lattes',
];
const sealText = 'SMALL BATCH · MADE TO ORDER · SINCE ' + site.established + ' · ';
---

<Base jsonLd={bakeryJsonLd(Astro.site)}>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Small-batch bakery · {site.location.city}, {site.location.region}</p>
        <h1 class="hero-title">Baked to order. Made to be <em>shared.</em></h1>
        <p class="lead hero-lead">
          Cinnamon rolls, mini cheesecakes, brown butter cookies, baklava, gift boxes, and halal cold cut trays,
          made fresh for your gatherings, your gifts, and your everyday treats.
        </p>
        <div class="btn-row">
          <a class="btn" href="/order/">Start an order <Icon name="arrow" class="arrow" /></a>
          <a class="btn btn-outline" href="/menu/">Browse the menu</a>
        </div>
        <ul class="hero-facts" role="list">
          <li><Icon name="clock" size={20} /> {site.ordering.noticeHours}-hour notice</li>
          <li><Icon name="truck" size={20} /> Pickup or local delivery</li>
          <li><Icon name="check-badge" size={20} /> Halal cold cuts</li>
        </ul>
      </div>

      <div class="hero-art" aria-hidden="true">
        <div class="cell cell-a hex">
          <Photo names={['cinnamon-rolls']} alt="" icon="roll" sizes="(min-width: 900px) 34vw, 70vw" eager />
        </div>
        <div class="cell cell-b hex">
          <Photo names={['cheesecake-strawberry', 'cheesecake-oreo']} alt="" icon="slice" sizes="(min-width: 900px) 24vw, 46vw" eager />
        </div>
        <div class="cell cell-c hex">
          <Photo names={['cookie-brown-butter', 'cookie-box']} alt="" icon="cookie" sizes="(min-width: 900px) 22vw, 44vw" />
        </div>
        <div class="cell cell-d hex"></div>
        <svg class="cell-e" viewBox="0 0 100 115.47">
          <path
            d="M54.5 2.6L95.5 26.27A9 9 0 0 1 100 34.06L100 81.41A9 9 0 0 1 95.5 89.2L54.5 112.87A9 9 0 0 1 45.5 112.87L4.5 89.2A9 9 0 0 1 0 81.41L0 34.06A9 9 0 0 1 4.5 26.27L45.5 2.6A9 9 0 0 1 54.5 2.6Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            vector-effect="non-scaling-stroke"></path>
        </svg>
        <div class="seal">
          <svg viewBox="0 0 120 120">
            <defs>
              <path id="seal-circle" d="M60 60m-46 0a46 46 0 1 1 92 0a46 46 0 1 1-92 0"></path>
            </defs>
            <text>
              <textPath href="#seal-circle" textLength="285">{sealText}</textPath>
            </text>
          </svg>
          <span class="seal-core"><Icon name="hex" size={22} /></span>
        </div>
      </div>
    </div>
  </section>

  <!-- Ticker -->
  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">
      {
        [0, 1].map(() => (
          <ul role="list">
            {tickerItems.map((t) => (
              <li>
                <span>{t}</span>
                <svg viewBox="0 0 100 115.47" class="tick-hex">
                  <path d="M50 0 100 28.87v57.73L50 115.47 0 86.6V28.87z" />
                </svg>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>

  <!-- Favorites -->
  <section class="section">
    <div class="container">
      <div class="head-row">
        <div class="section-head">
          <p class="eyebrow">Most loved</p>
          <h2>Our favorites</h2>
          <p>The bakes people order again and again.</p>
        </div>
        <a class="text-link" href="/menu/">See the full menu <Icon name="arrow" /></a>
      </div>
      <div class="grid grid-4">
        {favorites.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="section section-paper">
    <div class="container">
      <div class="section-head center">
        <p class="eyebrow">One kitchen, a full menu</p>
        <h2>Something for every table</h2>
        <p>From a box of cookies for a friend to a slider tray for the whole office.</p>
      </div>
      <ul class="cat-grid" role="list">
        {
          categories.map((c) => (
            <li data-reveal>
              <a href={`/menu/#${c.id}`} class="cat-tile">
                <span class="cat-icon">
                  <Icon name={c.icon} size={30} stroke={1.4} />
                </span>
                <span class="cat-text">
                  <span class="cat-name">{c.name}</span>
                  <span class="cat-blurb">{c.blurb}</span>
                </span>
                <span class="cat-count">{productsIn(c.id).length}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- How ordering works -->
  <section class="section section-dark how">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">How it works</p>
        <h2>Ordering is simple</h2>
        <p>Everything is baked fresh for you, so we ask for a little notice.</p>
      </div>
      <ol class="steps" role="list">
        <li data-reveal>
          <span class="step-num">01</span>
          <h3>Pick your treats</h3>
          <p>Browse the menu and choose your sizes. Most items have a small minimum, listed on each page.</p>
        </li>
        <li data-reveal>
          <span class="step-num">02</span>
          <h3>Send your order</h3>
          <p>
            Fill out our short order form at least {site.ordering.noticeHours} hours ahead. Strawberry boxes need 48
            hours.
          </p>
        </li>
        <li data-reveal>
          <span class="step-num">03</span>
          <h3>We confirm, you enjoy</h3>
          <p>
            We confirm your order and timing. Pick up in {site.location.city}, or we deliver within {
              site.delivery.radiusMiles
            } miles.
          </p>
        </li>
      </ol>
      <div class="btn-row">
        <a class="btn btn-honey" href="/order/">Start an order <Icon name="arrow" class="arrow" /></a>
        <a class="btn btn-ghost-dark" href="/policies/">Delivery details</a>
      </div>
    </div>
  </section>

  <!-- Catering -->
  <section class="section">
    <div class="container split">
      <div class="catering-art" data-reveal>
        <Photo
          names={['slider-tray', 'cold-cut-sub-cut']}
          alt="Cold cut slider gathering tray"
          icon="sandwich"
          ratio="5 / 4"
          sizes="(min-width: 900px) 50vw, 100vw"
        />
        <div class="float-card">
          <p class="float-label">Slider trays</p>
          <p class="float-sizes">{sliders?.tiers.map((t) => <span>{t.qty}</span>)}</p>
          {sliders && <p class="float-note">From {money(startingPrice(sliders))}</p>}
        </div>
      </div>
      <div>
        <p class="eyebrow">Catering &amp; large orders</p>
        <h2>Halal slider trays for meetings, parties, and community events</h2>
        <p class="lead">
          Mini cold cut subs on slider rolls, boxed lunches for small teams, and dessert trays to round it out. Every
          cold cut we serve is halal-certified.
        </p>
        <ul class="checks" role="list">
          {
            sliders?.tiers
              .filter((t) => t.serves)
              .map((t) => (
                <li>
                  <Icon name="check" size={20} /> {t.label} serves about {t.serves}
                </li>
              ))
          }
        </ul>
        <div class="btn-row">
          <a class="btn" href="/catering/">Plan your catering <Icon name="arrow" class="arrow" /></a>
          <a class="btn btn-outline" href="/menu/cold-cut-slider-tray/">See slider trays</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Occasions -->
  <section class="section section-oat">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Made for moments</p>
        <h2>{site.tagline}</h2>
      </div>
      <div class="grid grid-4">
        <article class="occasion" data-reveal>
          <Icon name="gift" size={30} stroke={1.4} />
          <h3>Gifting</h3>
          <p>Date boxes, baklava, and cookie boxes, packed beautifully and ready to give.</p>
        </article>
        <article class="occasion" data-reveal>
          <Icon name="users" size={30} stroke={1.4} />
          <h3>Gatherings</h3>
          <p>Mini cheesecakes and dessert trays for showers, birthdays, and family nights.</p>
        </article>
        <article class="occasion" data-reveal>
          <Icon name="box" size={30} stroke={1.4} />
          <h3>Office lunches</h3>
          <p>Boutique lunch boxes and slider trays that make feeding a team easy.</p>
        </article>
        <article class="occasion" data-reveal>
          <Icon name="sparkle" size={30} stroke={1.4} />
          <h3>Ramadan &amp; Eid</h3>
          <p>Seasonal date boxes and sweets for iftars, Eid visits, and favors.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Story -->
  <section class="section">
    <div class="container split">
      <div class="story-copy">
        <p class="eyebrow">Our name</p>
        <h2>Biese is our family name. <em>And yes, it sounds like “bees.”</em></h2>
        <p class="lead">
          Busy Biese is a family bakery in {site.location.city}. Since {site.established} we have baked in small
          batches, made every order fresh, and packed each one like a gift.
        </p>
        <p class="muted">
          Like a hive, we believe good things happen when people come together. A pan of cinnamon rolls, a box of
          dates, a tray for the office. Small moments, shared.
        </p>
        <a class="text-link" href="/about/">Read our story <Icon name="arrow" /></a>
      </div>
      <div class="values comb-bg" data-reveal>
        <p class="values-title">What we believe</p>
        <ul role="list">
          <li><Icon name="heart" size={22} /> Good food is made with care and intention.</li>
          <li><Icon name="users" size={22} /> Gathering around food strengthens community.</li>
          <li><Icon name="gift" size={22} /> Small gestures create meaningful moments.</li>
          <li><Icon name="hex" size={22} /> Thoughtfully made food is meant to be shared.</li>
        </ul>
      </div>
    </div>
  </section>

  {
    gallery.length >= 4 && (
      <section class="section-tight section-paper">
        <div class="container">
          <div class="section-head">
            <p class="eyebrow">From our kitchen</p>
            <h2>Fresh out of the oven</h2>
          </div>
          <ul class="gallery" role="list">
            {gallery.slice(0, 8).map((g) => (
              <li>
                <figure>
                  <Photo name={g.photo} alt="" ratio="1 / 1" sizes="(min-width: 900px) 25vw, 50vw" />
                  <figcaption class="gallery-label">{g.label}</figcaption>
                </figure>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- Community -->
  <section class="section-tight">
    <div class="container">
      <div class="community">
        <div>
          <p class="eyebrow">Stay in the loop</p>
          <h2>Follow along for seasonal boxes and new bakes.</h2>
        </div>
        <div class="btn-row">
          <a class="btn" href={site.links.instagram} target="_blank" rel="noopener">
            <Icon name="instagram" /> {site.links.instagramHandle}
          </a>
          <a class="btn btn-outline" href={site.links.whatsapp} target="_blank" rel="noopener">
            <Icon name="chat" /> WhatsApp community
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    padding: clamp(36px, 6vw, 80px) 0 clamp(48px, 7vw, 96px);
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0 0 0 45%;
    background-image: var(--comb);
    background-size: 56px 97px;
    -webkit-mask-image: radial-gradient(70% 70% at 70% 45%, #000 20%, transparent 75%);
    mask-image: radial-gradient(70% 70% at 70% 45%, #000 20%, transparent 75%);
    pointer-events: none;
  }
  .hero-grid {
    position: relative;
    display: grid;
    gap: clamp(36px, 6vw, 64px);
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1.08fr 0.92fr;
    }
  }
  .hero-title {
    font-size: var(--step-hero);
    font-weight: 480;
    line-height: 0.98;
    letter-spacing: -0.03em;
    margin-bottom: 24px;
  }
  .hero-title em {
    color: var(--honey-deep);
    font-weight: 440;
  }
  .hero-lead {
    max-width: 34rem;
    margin-bottom: 30px;
  }
  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 22px;
    margin-top: 30px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
    font-size: 0.92rem;
    font-weight: 650;
    color: var(--ink-2);
  }
  .hero-facts li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .hero-facts :global(svg) {
    color: var(--honey-deep);
  }

  .hero-art {
    position: relative;
    width: min(100%, 560px);
    aspect-ratio: 1 / 1;
    margin-inline: auto;
  }
  .cell {
    position: absolute;
    overflow: hidden;
  }
  .cell :global(.photo) {
    height: 100%;
  }
  .cell-a {
    width: 58%;
    left: 4%;
    top: 4%;
    z-index: 2;
  }
  .cell-b {
    width: 40%;
    right: 2%;
    top: 22%;
    z-index: 3;
  }
  .cell-c {
    width: 38%;
    left: 30%;
    bottom: -4%;
    z-index: 2;
  }
  .cell-d {
    width: 16%;
    right: 14%;
    top: 0;
    background: var(--honey);
    z-index: 1;
  }
  .cell-e {
    position: absolute;
    width: 24%;
    left: -2%;
    bottom: 6%;
    color: var(--honey-deep);
    opacity: 0.45;
  }
  .seal {
    position: absolute;
    right: 4%;
    bottom: 10%;
    width: 25%;
    aspect-ratio: 1;
    z-index: 4;
    background: var(--ink);
    color: var(--cream);
    border-radius: 50%;
    display: grid;
    place-items: center;
    box-shadow: var(--shadow);
  }
  .seal svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    animation: spin 28s linear infinite;
  }
  .seal text {
    font-family: var(--font-body);
    font-size: 10.5px;
    font-weight: 750;
    letter-spacing: 0.12em;
    fill: var(--cream);
  }
  .seal-core {
    color: var(--honey);
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Ticker */
  .ticker {
    background: var(--honey-soft);
    border-block: 1px solid rgba(138, 87, 16, 0.18);
    overflow: hidden;
    padding: 14px 0;
  }
  .ticker-track {
    display: flex;
    width: max-content;
    animation: ticker 48s linear infinite;
  }
  .ticker ul {
    display: flex;
    flex: none;
  }
  .ticker li {
    display: inline-flex;
    align-items: center;
    gap: 26px;
    padding-right: 26px;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.4vw + 0.7rem, 1.6rem);
    font-weight: 500;
    font-style: italic;
    color: var(--ink);
    white-space: nowrap;
  }
  .tick-hex {
    width: 12px;
    fill: var(--honey-deep);
  }
  @keyframes ticker {
    to {
      transform: translateX(-50%);
    }
  }

  /* Section header row */
  .head-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 8px 24px;
    margin-bottom: clamp(28px, 4vw, 48px);
  }
  .head-row .section-head {
    margin-bottom: 0;
  }

  /* Categories */
  .cat-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 330px), 1fr));
  }
  .cat-grid li {
    display: flex;
  }
  .cat-tile {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 18px 20px;
    min-height: 104px;
    background: var(--cream);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--ink);
    transition:
      background-color 0.25s var(--ease),
      border-color 0.25s var(--ease),
      transform 0.25s var(--ease);
  }
  .cat-tile:hover {
    background: var(--honey-wash);
    border-color: rgba(138, 87, 16, 0.3);
    transform: translateY(-2px);
    color: var(--ink);
  }
  .cat-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 60px;
    height: 69px;
    background: var(--honey-soft);
    color: var(--honey-deep);
    -webkit-mask: var(--hex-mask) center / 100% 100% no-repeat;
    mask: var(--hex-mask) center / 100% 100% no-repeat;
  }
  .cat-text {
    display: grid;
    gap: 3px;
    flex: 1;
  }
  .cat-name {
    font-family: var(--font-display);
    font-size: 1.22rem;
    font-weight: 540;
    line-height: 1.2;
  }
  .cat-blurb {
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.45;
  }
  .cat-count {
    flex: none;
    display: grid;
    place-items: center;
    min-width: 34px;
    height: 34px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    font-size: 0.85rem;
    font-weight: 750;
    color: var(--ink-2);
  }

  /* Steps */
  .steps {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    margin-bottom: 40px;
  }
  .steps li {
    padding: 28px 26px 26px;
    border: 1px solid rgba(246, 239, 229, 0.14);
    border-radius: var(--radius);
    background: var(--espresso-2);
  }
  .step-num {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 2.6rem;
    font-weight: 400;
    font-style: italic;
    line-height: 1;
    color: var(--honey);
    margin-bottom: 18px;
  }
  .steps h3 {
    font-size: 1.4rem;
    margin-bottom: 8px;
  }
  .steps p {
    margin: 0;
  }

  /* Catering */
  .catering-art {
    position: relative;
    margin-bottom: 28px;
  }
  @media (min-width: 900px) {
    .catering-art {
      margin-bottom: 0;
    }
  }
  .catering-art :global(.photo) {
    border-radius: var(--radius-l);
  }
  .float-card {
    position: absolute;
    right: clamp(12px, 3vw, 28px);
    bottom: clamp(-28px, -2vw, -16px);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 16px 20px;
    box-shadow: var(--shadow);
    min-width: 190px;
  }
  .float-label {
    font-size: var(--step-tiny);
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--honey-deep);
    margin: 0 0 6px;
  }
  .float-sizes {
    display: flex;
    gap: 8px;
    margin: 0 0 4px;
  }
  .float-sizes span {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: var(--honey-wash);
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 560;
  }
  .float-note {
    margin: 6px 0 0;
    font-size: 0.9rem;
    font-weight: 650;
    color: var(--muted);
  }
  .checks {
    display: grid;
    gap: 10px;
    margin: 6px 0 30px;
  }
  .checks li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    color: var(--ink-2);
  }
  .checks :global(svg) {
    flex: none;
    color: var(--ink);
    background: var(--honey-soft);
    border-radius: 999px;
    padding: 3px;
    width: 26px;
    height: 26px;
  }

  /* Occasions */
  .occasion {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 26px 24px 22px;
  }
  .occasion :global(svg) {
    color: var(--honey-deep);
    margin-bottom: 18px;
  }
  .occasion h3 {
    font-size: 1.3rem;
    margin-bottom: 8px;
  }
  .occasion p {
    color: var(--muted);
    margin: 0;
    font-size: 0.95rem;
  }

  /* Story */
  .story-copy h2 {
    font-size: var(--step-4);
  }
  .story-copy h2 em {
    display: block;
    color: var(--honey-deep);
    font-size: 0.62em;
    font-weight: 420;
    margin-top: 10px;
    letter-spacing: -0.01em;
  }
  .values {
    position: relative;
    background-color: var(--oat);
    border-radius: var(--radius-l);
    padding: clamp(26px, 4vw, 44px);
    border: 1px solid var(--line);
  }
  .values-title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 520;
    margin: 0 0 18px;
  }
  .values ul {
    display: grid;
    gap: 12px;
  }
  .values li {
    display: flex;
    align-items: center;
    gap: 14px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 14px 16px;
